<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Thực hiện kiểm kho | LIMS</title><script src="https://cdn.tailwindcss.com"></script></head><body class="bg-slate-50 text-slate-800"><main class="mx-auto max-w-6xl space-y-5 px-4 py-8"><a class="text-sm text-amber-700" href="${pageContext.request.contextPath}/app/warehouse/stocktakes">← Danh sách kiểm kho</a><div><h1 class="mt-2 text-2xl font-bold">Thực hiện kiểm kho #${check.checkId}</h1><p class="text-sm text-slate-500">Kiểm đếm thực tế theo từng serial; ghi vị trí và tình trạng. Mục máy không có trong hệ thống có thể nhập ở phần cuối.</p></div><c:if test="${not empty param.error}"><div class="rounded-lg bg-rose-50 p-3 text-sm text-rose-700"><c:out value="${param.error}"/></div></c:if><form method="post" action="${pageContext.request.contextPath}/app/warehouse/stocktakes" class="space-y-5"><input type="hidden" name="checkId" value="${check.checkId}"><div class="overflow-x-auto rounded-xl border bg-white shadow-sm"><table class="min-w-full text-left text-sm"><thead class="bg-slate-100 text-xs uppercase text-slate-600"><tr><th class="p-3">Sản phẩm / Serial</th><th class="p-3">Vị trí hệ thống</th><th class="p-3">Tình trạng thực tế</th><th class="p-3">Vị trí thực tế</th><th class="p-3">Lý do chênh lệch</th></tr></thead><tbody class="divide-y"><c:forEach var="d" items="${check.details}"><tr><td class="p-3"><c:out value="${d.productName}"/><div class="font-mono text-xs"><c:out value="${d.serialNumber}"/></div><input type="hidden" name="detailIds" value="${d.detailId}"><input type="hidden" name="productIds" value="${d.productId}"><input type="hidden" name="serialNumbers" value="${d.serialNumber}"></td><td class="p-3"><c:out value="${d.systemLocation}"/> · ${d.systemStatus}</td><td class="p-3"><select name="actualStatuses" required class="rounded border p-2"><option value="">Chọn</option><option value="IN_STOCK" ${d.actualStatus=='IN_STOCK'?'selected':''}>Có mặt, tốt</option><option value="DAMAGED" ${d.actualStatus=='DAMAGED'?'selected':''}>Có mặt, hư hỏng</option><option value="MISSING" ${d.actualStatus=='MISSING'?'selected':''}>Không tìm thấy</option></select></td><td class="p-3"><input name="actualLocations" maxlength="50" value="${d.actualLocation}" placeholder="A-01-02" class="w-32 rounded border p-2"></td><td class="p-3"><input name="reasons" maxlength="255" value="${d.discrepancyReason}" placeholder="Bắt buộc nếu có lệch" class="min-w-48 rounded border p-2"></td></tr></c:forEach><c:if test="${empty check.details}"><tr><td colspan="5" class="p-6 text-center text-slate-500">Không có máy trong phạm vi này; vẫn có thể khai báo máy tìm thấy bên dưới.</td></tr></c:if></tbody></table></div><section class="rounded-xl border bg-white p-4 shadow-sm"><h2 class="font-semibold">Serial thực tế có trong kho nhưng chưa có trong danh sách hệ thống</h2><p class="mb-3 text-xs text-slate-500">Chỉ điền các dòng có máy phát hiện được; để trống các dòng còn lại.</p><div class="space-y-2"><c:forEach begin="1" end="5" var="i"><div class="grid gap-2 sm:grid-cols-4"><input type="hidden" name="detailIds" value="0"><select name="productIds" class="rounded border p-2"><option value="">Model (nếu có serial ngoài hệ thống, chọn model)</option><c:forEach var="p" items="${products}"><option value="${p.productId}"><c:out value="${p.productCode}"/> · <c:out value="${p.productName}"/></option></c:forEach></select><input name="serialNumbers" maxlength="100" placeholder="Serial Number" class="rounded border p-2"><select name="actualStatuses" class="rounded border p-2"><option value="">Bỏ qua dòng trống</option><option value="IN_STOCK">Có mặt, tốt</option><option value="DAMAGED">Có mặt, hư hỏng</option></select><input name="actualLocations" maxlength="50" placeholder="Vị trí kho" class="rounded border p-2"><input name="reasons" maxlength="255" placeholder="Lý do / ghi chú" class="rounded border p-2 sm:col-span-4"></div></c:forEach></div></section><div class="flex gap-3"><button class="rounded-lg bg-amber-600 px-5 py-3 text-sm font-semibold text-white">Gửi kết quả cho Manager duyệt</button><a href="${pageContext.request.contextPath}/app/warehouse/stocktakes" class="rounded-lg border bg-white px-5 py-3 text-sm">Hủy</a></div></form></main></body></html>
