<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<div class="min-h-screen bg-slate-50 lg:flex">
    <!-- Warehouse Sidebar -->
    <aside class="hidden w-72 shrink-0 flex-col bg-slate-950 text-slate-200 lg:flex border-r border-slate-800">
        <a href="${pageContext.request.contextPath}/app/warehouse/dashboard" class="flex h-20 items-center gap-3 border-b border-white/10 px-6 transition hover:bg-white/[0.02]">
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-amber-500 text-lg text-white shadow-lg shadow-amber-950/40">
                <i class="fa-solid fa-warehouse"></i>
            </span>
            <div>
                <span class="text-lg font-bold tracking-wide text-white">LIMS</span>
                <span class="block text-xs font-medium text-amber-400">Warehouse Staff</span>
            </div>
        </a>

        <nav class="flex-1 space-y-2 overflow-y-auto px-4 py-6">
            <p class="px-3 pb-2 text-[10px] font-bold uppercase tracking-[0.18em] text-slate-500">TỔNG QUAN</p>
            <a href="${pageContext.request.contextPath}/app/warehouse/dashboard" 
               class="flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-sm transition ${activeWarehouseMenu == 'dashboard' ? 'bg-amber-500 font-semibold text-white shadow-md shadow-amber-950/30' : 'text-slate-300 hover:bg-white/5 hover:text-white'}">
                <i class="fa-solid fa-chart-pie w-5 text-center ${activeWarehouseMenu == 'dashboard' ? 'text-white' : 'text-slate-400'}"></i>
                <span>Dashboard & Công việc</span>
            </a>
            <a href="${pageContext.request.contextPath}/app/warehouse/inventory" 
               class="flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-sm transition ${activeWarehouseMenu == 'inventory' ? 'bg-amber-500 font-semibold text-white shadow-md shadow-amber-950/30' : 'text-slate-300 hover:bg-white/5 hover:text-white'}">
                <i class="fa-solid fa-laptop w-5 text-center ${activeWarehouseMenu == 'inventory' ? 'text-white' : 'text-slate-400'}"></i>
                <span>Tra cứu & Hiện vật kho</span>
            </a>

            <p class="px-3 pb-2 pt-5 text-[10px] font-bold uppercase tracking-[0.18em] text-slate-500">NGHIỆP VỤ KHO</p>
            
            <!-- Nhập kho -->
            <details class="group" ${activeWarehouseMenu == 'handovers' or activeWarehouseMenu == 'import-history' ? 'open' : ''}>
                <summary class="flex cursor-pointer list-none items-center gap-3 rounded-xl px-3.5 py-2.5 text-sm transition ${activeWarehouseMenu == 'handovers' or activeWarehouseMenu == 'import-history' ? 'bg-amber-500/20 text-amber-300 font-semibold border border-amber-500/30' : 'text-slate-300 hover:bg-white/5 hover:text-white'}">
                    <i class="fa-solid fa-boxes-stacked w-5 text-center"></i>
                    <span class="flex-1">Nhập kho</span>
                    <i class="fa-solid fa-chevron-down text-[10px] transition group-open:rotate-180"></i>
                </summary>
                <div class="ml-5 mt-1 space-y-1 border-l border-white/10 pl-3">
                    <a href="${pageContext.request.contextPath}/app/warehouse/handovers" class="block rounded-lg px-3 py-2 text-xs ${activeWarehouseMenu == 'handovers' ? 'bg-white/10 font-semibold text-white' : 'text-slate-400 hover:bg-white/5 hover:text-white'}">
                        Tiếp nhận & Tạo phiếu nhập
                    </a>
                    <a href="${pageContext.request.contextPath}/app/warehouse/import-history" class="block rounded-lg px-3 py-2 text-xs ${activeWarehouseMenu == 'import-history' ? 'bg-white/10 font-semibold text-white' : 'text-slate-400 hover:bg-white/5 hover:text-white'}">
                        Lịch sử nhập kho
                    </a>
                </div>
            </details>

            <!-- Xuất kho -->
            <details class="group" ${activeWarehouseMenu == 'exports' or activeWarehouseMenu == 'export-history' ? 'open' : ''}>
                <summary class="flex cursor-pointer list-none items-center gap-3 rounded-xl px-3.5 py-2.5 text-sm transition ${activeWarehouseMenu == 'exports' or activeWarehouseMenu == 'export-history' ? 'bg-amber-500/20 text-amber-300 font-semibold border border-amber-500/30' : 'text-slate-300 hover:bg-white/5 hover:text-white'}">
                    <i class="fa-solid fa-truck-ramp-box w-5 text-center"></i>
                    <span class="flex-1">Xuất kho</span>
                    <i class="fa-solid fa-chevron-down text-[10px] transition group-open:rotate-180"></i>
                </summary>
                <div class="ml-5 mt-1 space-y-1 border-l border-white/10 pl-3">
                    <a href="${pageContext.request.contextPath}/app/warehouse/export-requests" class="block rounded-lg px-3 py-2 text-xs ${activeWarehouseMenu == 'exports' ? 'bg-white/10 font-semibold text-white' : 'text-slate-400 hover:bg-white/5 hover:text-white'}">
                        Đơn chờ soạn xuất
                    </a>
                    <a href="${pageContext.request.contextPath}/app/warehouse/export-history" class="block rounded-lg px-3 py-2 text-xs ${activeWarehouseMenu == 'export-history' ? 'bg-white/10 font-semibold text-white' : 'text-slate-400 hover:bg-white/5 hover:text-white'}">
                        Lịch sử xuất kho
                    </a>
                </div>
            </details>

            <!-- Kiểm kê kho -->
            <details class="group" ${activeWarehouseMenu == 'stocktakes' ? 'open' : ''}>
                <summary class="flex cursor-pointer list-none items-center gap-3 rounded-xl px-3.5 py-2.5 text-sm transition ${activeWarehouseMenu == 'stocktakes' ? 'bg-amber-500/20 text-amber-300 font-semibold border border-amber-500/30' : 'text-slate-300 hover:bg-white/5 hover:text-white'}">
                    <i class="fa-solid fa-clipboard-list w-5 text-center"></i>
                    <span class="flex-1">Kiểm kê kho</span>
                    <i class="fa-solid fa-chevron-down text-[10px] transition group-open:rotate-180"></i>
                </summary>
                <div class="ml-5 mt-1 space-y-1 border-l border-white/10 pl-3">
                    <a href="${pageContext.request.contextPath}/app/warehouse/stocktakes" class="block rounded-lg px-3 py-2 text-xs ${activeWarehouseMenu == 'stocktakes' ? 'bg-white/10 font-semibold text-white' : 'text-slate-400 hover:bg-white/5 hover:text-white'}">
                        Đợt kiểm kê được giao
                    </a>
                </div>
            </details>
        </nav>

        <div class="border-t border-white/10 p-4">
            <div class="flex items-center gap-3 rounded-xl bg-white/5 p-3">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-amber-400/20 text-amber-200">
                    <i class="fa-solid fa-user-gear"></i>
                </span>
                <div class="min-w-0">
                    <p class="truncate text-sm font-semibold text-white"><c:out value="${user.fullName}"/></p>
                    <p class="mt-0.5 text-xs text-amber-400">Warehouse Staff</p>
                </div>
                <a href="${pageContext.request.contextPath}/logout" title="Đăng xuất" 
                   class="ml-auto rounded-lg p-2 text-slate-400 transition hover:bg-rose-500/10 hover:text-rose-300">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                </a>
            </div>
        </div>
    </aside>

    <!-- Main Container -->
    <div class="flex min-w-0 flex-1 flex-col">
        <header class="sticky top-0 z-20 flex h-16 items-center justify-between border-b border-slate-200 bg-white/95 px-4 shadow-sm backdrop-blur sm:px-6 lg:px-8">
            <div class="flex items-center gap-3">
                <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-amber-50 text-amber-700 lg:hidden">
                    <i class="fa-solid fa-warehouse"></i>
                </span>
                <div>
                    <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-slate-400">LIMS / Warehouse</p>
                    <p class="text-sm font-semibold text-slate-800">
                        <c:out value="${activeWarehouseMenu == 'dashboard' ? 'Dashboard & Công việc kho' : activeWarehouseMenu == 'exports' ? 'Quản lý Xuất kho' : activeWarehouseMenu == 'stocktakes' ? 'Kiểm kê kho' : 'Quản lý Nhập kho'}"/>
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <span class="hidden text-sm font-medium text-slate-600 sm:inline"><c:out value="${user.fullName}"/></span>
                <a href="${pageContext.request.contextPath}/logout" class="inline-flex items-center gap-2 rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-600 hover:border-rose-200 hover:bg-rose-50 hover:text-rose-700 transition">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                    <span class="hidden sm:inline">Đăng xuất</span>
                </a>
            </div>
        </header>

        <!-- Mobile Navigation Strip -->
        <details class="border-b border-slate-200 bg-white px-4 py-2 lg:hidden">
            <summary class="flex cursor-pointer list-none items-center justify-between rounded-lg px-3 py-2 text-sm font-semibold text-slate-700">
                <span><i class="fa-solid fa-bars mr-2 text-amber-600"></i>Điều hướng kho</span>
                <i class="fa-solid fa-chevron-down text-xs"></i>
            </summary>
            <div class="flex flex-col gap-1 pb-2 pt-2 text-xs">
                <a class="rounded-lg px-3 py-2 hover:bg-slate-50" href="${pageContext.request.contextPath}/app/warehouse/dashboard">Dashboard</a>
                <a class="rounded-lg px-3 py-2 hover:bg-slate-50" href="${pageContext.request.contextPath}/app/warehouse/inventory">Tra cứu Laptop & Hiện vật</a>
                <a class="rounded-lg px-3 py-2 hover:bg-slate-50" href="${pageContext.request.contextPath}/app/warehouse/handovers">Tiếp nhận nhập kho</a>
                <a class="rounded-lg px-3 py-2 hover:bg-slate-50" href="${pageContext.request.contextPath}/app/warehouse/export-requests">Đơn chờ xuất</a>
                <a class="rounded-lg px-3 py-2 hover:bg-slate-50" href="${pageContext.request.contextPath}/app/warehouse/stocktakes">Kiểm kê</a>
            </div>
        </details>
