<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" language="java" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Lập phiếu nhập kho | LIMS Warehouse</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"></head><body class="bg-slate-50 text-slate-800"><c:set var="activeWarehouseMenu" value="handovers"/><%@ include file="shell.jspf" %><main class="mx-auto max-w-5xl space-y-5 px-4 py-6 sm:px-6 sm:py-8"><a href="${pageContext.request.contextPath}/app/warehouse/handovers" class="text-sm font-medium text-amber-700">← Phiếu bàn giao được giao cho tôi</a><div><h1 class="mt-2 text-2xl font-bold">Lập phiếu nhập kho</h1><p class="mt-1 text-sm text-slate-500">Quét serial và ghi vị trí xếp kho cho từng máy. Manager duyệt phiếu xong, hệ thống mới ghi tăng tồn kho.</p></div><c:if test="${not empty error}"><div class="rounded-lg border border-rose-200 bg-rose-50 p-3 text-sm text-rose-700"><c:out value="${error}"/></div></c:if>
<section class="grid gap-3 rounded-xl border border-slate-200 bg-white p-5 text-sm sm:grid-cols-2"><div><span class="text-slate-500">Mã phiếu bàn giao:</span> <b>#${handover.handoverId}</b></div><div><span class="text-slate-500">Đơn mua:</span> <b>PO #${handover.requestId}</b></div><div><span class="text-slate-500">Nhà cung cấp:</span> <b><c:out value="${handover.supplierName}"/></b></div><div><span class="text-slate-500">Người bàn giao:</span> <b><c:out value="${handover.handoverBy}"/></b></div><div><span class="text-slate-500">Người mua hàng:</span> <b><c:out value="${handover.purchasingStaffName}"/></b></div><div><span class="text-slate-500">Địa điểm bàn giao:</span> <b><c:out value="${handover.location}"/></b></div><div><span class="text-slate-500">Ngày bàn giao:</span> <b><fmt:formatDate value="${handover.handoverDate}" pattern="dd/MM/yyyy HH:mm"/></b></div><div><span class="text-slate-500">Tổng số máy:</span> <b>${handover.handoverQuantity}</b></div></section>
<form method="post" action="${pageContext.request.contextPath}/app/warehouse/import-receipts" class="space-y-5"><input type="hidden" name="handoverId" value="${handover.handoverId}"><section class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm"><div class="border-b border-slate-100 p-5"><h2 class="font-bold">Serial Number và vị trí xếp kho</h2><p class="mt-1 text-sm text-slate-500">Mỗi dòng tương ứng một máy trong phiếu bàn giao. Serial phải duy nhất.</p></div><div class="overflow-x-auto"><table class="min-w-[850px] w-full text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="px-3 py-3">Sản phẩm</th><th class="px-3 py-3">Mã</th><th class="px-3 py-3">Serial Number</th><th class="px-3 py-3">Vị trí / kệ</th><th class="px-3 py-3">Tình trạng</th></tr></thead><tbody class="divide-y divide-slate-100"><c:forEach var="item" items="${handover.items}"><c:forEach var="unit" begin="1" end="${item.quantity}"><tr><td class="px-3 py-3"><c:out value="${item.productName}"/></td><td class="px-3 py-3"><c:out value="${item.productCode}"/><input type="hidden" name="productIds" value="${item.productId}"></td><td class="px-3 py-3"><input name="serialNumbers" maxlength="100" required class="w-48 rounded-lg border border-slate-300 px-3 py-2" placeholder="Quét Serial"></td><td class="px-3 py-3"><input name="locations" maxlength="50" required class="w-40 rounded-lg border border-slate-300 px-3 py-2" placeholder="Khu-kệ-tầng-ô"></td><td class="px-3 py-3"><select name="conditions" class="rounded-lg border border-slate-300 px-3 py-2"><option value="BRAND_NEW">Mới, nguyên vẹn</option><option value="SCRATCHED">Trầy xước</option><option value="DEFECTIVE">Hư hỏng</option></select></td></tr></c:forEach></c:forEach></tbody></table></div></section>
<section class="space-y-3 rounded-xl border border-slate-200 bg-white p-5"><label class="block text-sm font-semibold">Ghi chú tiếp nhận<textarea name="note" maxlength="255" rows="3" class="mt-1.5 w-full rounded-lg border border-slate-300 px-3 py-2.5" placeholder="Ghi nhận thêm khi kiểm đếm"></textarea></label><label class="flex items-start gap-3 rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm"><input type="checkbox" name="paperSigned" required class="mt-0.5"><span>Tôi xác nhận đã đối chiếu phiếu bàn giao giấy và phiếu đã có chữ ký xác nhận của người bàn giao, người tiếp nhận.</span></label><p class="text-xs text-slate-500">Khi gửi, phiếu ở trạng thái Chờ Manager duyệt. Tồn kho chưa thay đổi cho đến khi Manager phê duyệt.</p></section><div class="flex gap-3"><button class="rounded-lg bg-amber-600 px-5 py-2.5 text-sm font-semibold text-white"><i class="fa-solid fa-paper-plane mr-2"></i>Gửi phiếu nhập cho Manager</button><a href="${pageContext.request.contextPath}/app/warehouse/handovers" class="rounded-lg border border-slate-300 bg-white px-5 py-2.5 text-sm font-semibold">Hủy</a></div></form></main></div></div></body></html>


