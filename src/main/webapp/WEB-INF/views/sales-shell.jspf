<%@ page pageEncoding="UTF-8" %>
<div class="min-h-screen bg-slate-50 lg:flex">
    <aside class="fixed inset-y-0 left-0 z-20 hidden w-64 flex-col border-r border-slate-200 bg-white lg:flex">
        <a href="${pageContext.request.contextPath}/app/sales/export-requests" class="flex h-16 items-center gap-3 border-b border-slate-100 px-5 font-bold"><span class="flex h-10 w-10 items-center justify-center rounded-xl bg-indigo-600 text-white"><i class="fa-solid fa-laptop"></i></span><span>LIMS<span class="block text-xs font-normal text-slate-500">Sales workspace</span></span></a>
        <nav class="flex-1 space-y-1 p-3 text-sm">
            <p class="px-3 pb-1 pt-2 text-[11px] font-bold uppercase tracking-wider text-slate-400">Tổng quan</p>
            <a href="${pageContext.request.contextPath}/home" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-slate-600 hover:bg-slate-50"><i class="fa-solid fa-house w-5"></i> Trang chủ</a>
            <p class="px-3 pb-1 pt-5 text-[11px] font-bold uppercase tracking-wider text-slate-400">Bán hàng</p>
            <a href="${pageContext.request.contextPath}/app/sales/export-requests" class="flex items-center gap-3 rounded-lg px-3 py-2.5 ${activeSalesMenu == 'exports' ? 'bg-indigo-50 font-semibold text-indigo-700' : 'text-slate-600 hover:bg-slate-50'}"><i class="fa-solid fa-file-lines w-5"></i> Yêu cầu xuất kho</a>
            <p class="px-3 pb-1 pt-5 text-[11px] font-bold uppercase tracking-wider text-slate-400">Tài khoản</p>
            <a href="${pageContext.request.contextPath}/home" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-slate-600 hover:bg-slate-50"><i class="fa-solid fa-user w-5"></i> Thông tin cá nhân</a>
            <a href="${pageContext.request.contextPath}/logout" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-rose-600 hover:bg-rose-50"><i class="fa-solid fa-arrow-right-from-bracket w-5"></i> Đăng xuất</a>
        </nav>
        <div class="border-t border-slate-100 p-4"><div class="flex items-center gap-3"><span class="flex h-10 w-10 items-center justify-center rounded-full bg-indigo-100 text-indigo-700"><i class="fa-solid fa-user-tag"></i></span><div class="min-w-0"><p class="truncate text-sm font-semibold text-slate-800"><c:out value="${user.fullName}"/></p><p class="text-xs text-slate-500">@<c:out value="${user.username}"/> · Sales Staff</p></div></div></div>
    </aside>
    <div class="min-w-0 flex-1 lg:ml-64">
        <header class="sticky top-0 z-10 flex h-16 items-center justify-between border-b border-slate-200 bg-white/95 px-4 backdrop-blur sm:px-6"><div><p class="text-[10px] font-bold uppercase tracking-widest text-slate-400">LIMS / SALES</p><p class="text-sm font-semibold text-slate-800">Quản lý yêu cầu xuất kho</p></div><div class="flex items-center gap-3 text-sm"><span class="hidden text-slate-500 sm:inline"><c:out value="${user.fullName}"/></span><a href="${pageContext.request.contextPath}/logout" class="text-rose-600 lg:hidden">Đăng xuất</a></div></header>
        <nav class="sticky top-16 z-10 flex gap-2 overflow-x-auto border-b border-slate-200 bg-white px-3 py-2 lg:hidden"><a href="${pageContext.request.contextPath}/home" class="whitespace-nowrap rounded-lg bg-slate-100 px-3 py-2 text-xs font-semibold text-slate-600">Trang chủ</a><a href="${pageContext.request.contextPath}/app/sales/export-requests" class="whitespace-nowrap rounded-lg bg-indigo-600 px-3 py-2 text-xs font-semibold text-white">Yêu cầu xuất kho</a></nav>
        <main class="mx-auto max-w-7xl space-y-6 px-4 py-6 sm:px-6 sm:py-8">
            <c:if test="${not empty notice}"><div class="rounded-lg border border-emerald-200 bg-emerald-50 p-3 text-sm text-emerald-800"><c:out value="${notice}"/></div></c:if>
            <c:if test="${not empty error}"><div class="rounded-lg border border-rose-200 bg-rose-50 p-3 text-sm text-rose-800"><c:out value="${error}"/></div></c:if>
