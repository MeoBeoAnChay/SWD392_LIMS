<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Master Data | LIMS Manager</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"></head><body class="bg-slate-50 text-slate-800"><c:set var="activeManagerMenu" value="catalog"/><%@ include file="shell.jspf" %><main class="mx-auto max-w-7xl space-y-6 px-4 py-6 sm:px-6 sm:py-8">
<div><p class="text-xs font-bold uppercase tracking-wider text-indigo-600">Manager / Master Data</p><h1 class="mt-1 text-2xl font-bold">${catalogTab == 'products' ? 'Quản lý sản phẩm · Model & cấu hình' : catalogTab == 'brands' ? 'Quản lý thương hiệu' : catalogTab == 'lines' ? 'Quản lý dòng máy' : catalogTab == 'suppliers' ? 'Hồ sơ nhà cung cấp' : 'Hồ sơ khách hàng'}</h1><p class="mt-1 text-sm text-slate-500">Quản lý cấu hình model, thương hiệu, dòng máy, nhà cung cấp và khách hàng.</p></div><c:if test="${not empty param.notice}"><div class="rounded-lg border border-emerald-200 bg-emerald-50 p-3 text-sm text-emerald-800"><c:out value="${param.notice}"/></div></c:if><c:if test="${not empty param.error}"><div class="rounded-lg border border-rose-200 bg-rose-50 p-3 text-sm text-rose-700"><c:out value="${param.error}"/></div></c:if>
<c:if test="${catalogTab=='products'}"><section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><h2 class="mb-4 font-semibold">${not empty editProduct?'Cập nhật model laptop':'Thêm model laptop'}</h2><form method="post" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4"><input type="hidden" name="action" value="saveProduct"><input type="hidden" name="tab" value="products"><input type="hidden" name="productId" value="${editProduct.productId}"><label class="text-sm">Mã model<input required maxlength="50" name="productCode" value="${editProduct.productCode}" class="mt-1 w-full rounded-lg border p-2"></label><label class="text-sm">Tên model<input required maxlength="150" name="productName" value="${editProduct.productName}" class="mt-1 w-full rounded-lg border p-2"></label><label class="text-sm">Dòng máy<select required name="productLineId" class="mt-1 w-full rounded-lg border p-2"><option value="">Chọn dòng máy</option><c:forEach var="l" items="${lines}"><c:if test="${l.status=='ACTIVE'}"><option value="${l.productLineId}" ${editProduct.productLineId==l.productLineId?'selected':''}><c:out value="${l.brandName}"/> · <c:out value="${l.lineName}"/></option></c:if></c:forEach></select></label><label class="text-sm">Giá bán<input required type="number" min="0.01" step="0.01" name="unitPrice" value="${editProduct.unitPrice}" class="mt-1 w-full rounded-lg border p-2"></label><label class="text-sm">CPU<input required maxlength="100" name="cpu" value="${editProduct.cpu}" class="mt-1 w-full rounded-lg border p-2"></label><label class="text-sm">RAM<input required maxlength="50" name="ram" value="${editProduct.ram}" class="mt-1 w-full rounded-lg border p-2"></label><label class="text-sm">SSD / Storage<input required maxlength="100" name="storage" value="${editProduct.storage}" class="mt-1 w-full rounded-lg border p-2"></label><label class="text-sm">GPU<input maxlength="100" name="gpu" value="${editProduct.gpu}" class="mt-1 w-full rounded-lg border p-2"></label><label class="text-sm">Màn hình<input maxlength="50" name="screen" value="${editProduct.screen}" class="mt-1 w-full rounded-lg border p-2"></label><label class="text-sm">Trạng thái<select name="status" class="mt-1 w-full rounded-lg border p-2"><option ${empty editProduct or editProduct.status=='ACTIVE'?'selected':''}>ACTIVE</option><option ${editProduct.status=='INACTIVE'?'selected':''}>INACTIVE</option><option ${editProduct.status=='DISCONTINUED'?'selected':''}>DISCONTINUED</option></select></label><div class="flex items-end gap-2"><button class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white">Lưu model</button><c:if test="${not empty editProduct}"><a href="?tab=products" class="rounded-lg border px-4 py-2 text-sm">Hủy sửa</a></c:if></div></form></section><section class="overflow-hidden rounded-xl border bg-white shadow-sm"><div class="overflow-x-auto"><table class="min-w-full text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="p-3">Model</th><th class="p-3">Thương hiệu / Dòng</th><th class="p-3">Cấu hình</th><th class="p-3">Giá</th><th class="p-3">Trạng thái</th><th class="p-3">Thao tác</th></tr></thead><tbody class="divide-y"><c:forEach var="p" items="${products}"><tr><td class="p-3 font-semibold"><c:out value="${p.productCode}"/><div class="font-normal text-slate-600"><c:out value="${p.productName}"/></div></td><td class="p-3"><c:out value="${p.brandName}"/> · <c:out value="${p.lineName}"/></td><td class="p-3 text-xs">CPU <c:out value="${p.cpu}"/> · RAM <c:out value="${p.ram}"/> · SSD <c:out value="${p.storage}"/><div>GPU <c:out value="${p.gpu}"/> · <c:out value="${p.screen}"/></div></td><td class="whitespace-nowrap p-3"><fmt:formatNumber value="${p.unitPrice}" type="number" maxFractionDigits="0"/> ₫</td><td class="p-3">${p.status}</td><td class="p-3"><a href="?tab=products&amp;edit=${p.productId}" class="text-indigo-600">Sửa</a><c:if test="${p.status=='ACTIVE'}"><form method="post" class="mt-2"><input type="hidden" name="tab" value="products"><input type="hidden" name="action" value="deactivateProduct"><input type="hidden" name="productId" value="${p.productId}"><button class="text-xs text-rose-600" onclick="return confirm('Ngừng kinh doanh model này?')">Ngừng dùng</button></form></c:if></td></tr></c:forEach></tbody></table></div></section></c:if>
<c:if test="${catalogTab=='brands'}"><section class="rounded-xl border bg-white p-5 shadow-sm"><h2 class="mb-3 font-semibold">${not empty editBrand?'Sửa thương hiệu':'Thêm thương hiệu'}</h2><form method="post" class="flex flex-wrap items-end gap-3"><input type="hidden" name="action" value="saveBrand"><input type="hidden" name="tab" value="brands"><input type="hidden" name="brandId" value="${editBrand.brandId}"><label class="min-w-64 flex-1 text-sm">Tên thương hiệu<input required maxlength="100" name="brandName" value="${editBrand.brandName}" class="mt-1 w-full rounded-lg border p-2"></label><label class="text-sm">Trạng thái<select name="status" class="mt-1 rounded-lg border p-2"><option ${empty editBrand or editBrand.status=='ACTIVE'?'selected':''}>ACTIVE</option><option ${editBrand.status=='INACTIVE'?'selected':''}>INACTIVE</option></select></label><button class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white">Lưu</button></form></section><section class="overflow-hidden rounded-xl border bg-white"><table class="min-w-full text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="p-3">Thương hiệu</th><th class="p-3">Trạng thái</th><th class="p-3">Thao tác</th></tr></thead><tbody class="divide-y"><c:forEach var="b" items="${brands}"><tr><td class="p-3 font-medium"><c:out value="${b.brandName}"/></td><td class="p-3">${b.status}</td><td class="flex gap-3 p-3"><a href="?tab=brands&amp;edit=${b.brandId}" class="text-indigo-600">Sửa</a><form method="post"><input type="hidden" name="tab" value="brands"><input type="hidden" name="action" value="deleteBrand"><input type="hidden" name="brandId" value="${b.brandId}"><button class="text-rose-600" onclick="return confirm('Xóa thương hiệu? Chỉ xóa được khi chưa có dòng máy.')">Xóa</button></form></td></tr></c:forEach></tbody></table></section></c:if>
<c:if test="${catalogTab=='lines'}"><section class="rounded-xl border bg-white p-5 shadow-sm"><h2 class="mb-3 font-semibold">${not empty editLine?'Sửa dòng máy':'Thêm dòng máy'}</h2><form method="post" class="grid gap-3 sm:grid-cols-4"><input type="hidden" name="action" value="saveLine"><input type="hidden" name="tab" value="lines"><input type="hidden" name="lineId" value="${editLine.productLineId}"><label class="text-sm">Thương hiệu<select required name="brandId" class="mt-1 w-full rounded-lg border p-2"><option value="">Chọn thương hiệu</option><c:forEach var="b" items="${brands}"><c:if test="${b.status=='ACTIVE'}"><option value="${b.brandId}" ${editLine.brandId==b.brandId?'selected':''}><c:out value="${b.brandName}"/></option></c:if></c:forEach></select></label><label class="text-sm">Tên dòng máy<input required maxlength="100" name="lineName" value="${editLine.lineName}" class="mt-1 w-full rounded-lg border p-2"></label><label class="text-sm">Trạng thái<select name="status" class="mt-1 w-full rounded-lg border p-2"><option ${empty editLine or editLine.status=='ACTIVE'?'selected':''}>ACTIVE</option><option ${editLine.status=='INACTIVE'?'selected':''}>INACTIVE</option></select></label><div class="flex items-end"><button class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white">Lưu dòng máy</button></div></form></section><section class="overflow-hidden rounded-xl border bg-white"><table class="min-w-full text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="p-3">Thương hiệu</th><th class="p-3">Dòng máy</th><th class="p-3">Trạng thái</th><th class="p-3">Thao tác</th></tr></thead><tbody class="divide-y"><c:forEach var="l" items="${lines}"><tr><td class="p-3"><c:out value="${l.brandName}"/></td><td class="p-3 font-medium"><c:out value="${l.lineName}"/></td><td class="p-3">${l.status}</td><td class="p-3"><a href="?tab=lines&amp;edit=${l.productLineId}" class="mr-3 text-indigo-600">Sửa</a><form method="post" class="inline"><input type="hidden" name="tab" value="lines"><input type="hidden" name="action" value="setLineStatus"><input type="hidden" name="lineId" value="${l.productLineId}"><input type="hidden" name="status" value="${l.status=='ACTIVE'?'INACTIVE':'ACTIVE'}"><button class="text-xs text-amber-700">${l.status=='ACTIVE'?'Ngừng dùng':'Kích hoạt'}</button></form></td></tr></c:forEach></tbody></table></section></c:if>
<c:if test="${catalogTab=='suppliers'}"><section class="rounded-xl border bg-white p-5 shadow-sm"><h2 class="mb-3 font-semibold">${not empty editSupplier?'Cập nhật hồ sơ nhà cung cấp':'Thêm nhà cung cấp'}</h2><form method="post" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3"><input type="hidden" name="action" value="saveSupplier"><input type="hidden" name="tab" value="suppliers"><input type="hidden" name="supplierId" value="${editSupplier.supplierId}"><label class="text-sm">Tên công ty<input required maxlength="150" name="supplierName" value="${editSupplier.supplierName}" class="mt-1 w-full rounded-lg border p-2"></label><label class="text-sm">Người liên hệ<input maxlength="100" name="contactName" value="${editSupplier.contactName}" class="mt-1 w-full rounded-lg border p-2"></label><label class="text-sm">Email<input required type="email" maxlength="100" name="email" value="${editSupplier.email}" class="mt-1 w-full rounded-lg border p-2"></label><label class="text-sm">Điện thoại<input required maxlength="20" name="phone" value="${editSupplier.phone}" class="mt-1 w-full rounded-lg border p-2"></label><label class="text-sm">Địa chỉ<input maxlength="255" name="address" value="${editSupplier.address}" class="mt-1 w-full rounded-lg border p-2"></label><label class="text-sm">Trạng thái<select name="status" class="mt-1 w-full rounded-lg border p-2"><option ${empty editSupplier or editSupplier.status=='ACTIVE'?'selected':''}>ACTIVE</option><option ${editSupplier.status=='INACTIVE'?'selected':''}>INACTIVE</option></select></label><button class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white sm:col-span-2 lg:col-span-3 lg:justify-self-start">Lưu hồ sơ</button></form></section><section class="overflow-hidden rounded-xl border bg-white"><div class="overflow-x-auto"><table class="min-w-full text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="p-3">Nhà cung cấp</th><th class="p-3">Liên hệ</th><th class="p-3">Email / Điện thoại</th><th class="p-3">Địa chỉ</th><th class="p-3">Trạng thái</th><th class="p-3">Thao tác</th></tr></thead><tbody class="divide-y"><c:forEach var="s" items="${suppliers}"><tr><td class="p-3 font-medium"><c:out value="${s.supplierName}"/></td><td class="p-3"><c:out value="${s.contactName}"/></td><td class="p-3"><c:out value="${s.email}"/><div><c:out value="${s.phone}"/></div></td><td class="p-3"><c:out value="${s.address}"/></td><td class="p-3">${s.status}</td><td class="p-3"><a href="?tab=suppliers&amp;edit=${s.supplierId}" class="text-indigo-600">Sửa</a></td></tr></c:forEach></tbody></table></div></section></c:if>
<c:if test="${catalogTab=='customers'}"><section class="rounded-xl border bg-white p-5 shadow-sm"><h2 class="mb-3 font-semibold">${not empty editCustomer?'Cập nhật hồ sơ khách hàng':'Thêm khách hàng'}</h2><form method="post" class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3"><input type="hidden" name="action" value="saveCustomer"><input type="hidden" name="tab" value="customers"><input type="hidden" name="customerId" value="${editCustomer.customerId}"><label class="text-sm">Tên khách hàng / công ty<input required maxlength="150" name="customerName" value="${editCustomer.customerName}" class="mt-1 w-full rounded-lg border p-2"></label><label class="text-sm">Điện thoại<input required maxlength="20" name="phone" value="${editCustomer.phone}" class="mt-1 w-full rounded-lg border p-2"></label><label class="text-sm">Email<input type="email" maxlength="100" name="email" value="${editCustomer.email}" class="mt-1 w-full rounded-lg border p-2"></label><label class="text-sm">Địa chỉ<input maxlength="255" name="address" value="${editCustomer.address}" class="mt-1 w-full rounded-lg border p-2"></label><label class="text-sm">Trạng thái<select name="status" class="mt-1 w-full rounded-lg border p-2"><option ${empty editCustomer or editCustomer.status=='ACTIVE'?'selected':''}>ACTIVE</option><option ${editCustomer.status=='INACTIVE'?'selected':''}>INACTIVE</option></select></label><button class="rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white">Lưu hồ sơ</button></form></section><section class="overflow-hidden rounded-xl border bg-white"><div class="overflow-x-auto"><table class="min-w-full text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="p-3">Khách hàng</th><th class="p-3">Điện thoại</th><th class="p-3">Email</th><th class="p-3">Địa chỉ</th><th class="p-3">Trạng thái</th><th class="p-3">Thao tác</th></tr></thead><tbody class="divide-y"><c:forEach var="c" items="${customers}"><tr><td class="p-3 font-medium"><c:out value="${c.customerName}"/></td><td class="p-3"><c:out value="${c.phone}"/></td><td class="p-3"><c:out value="${c.email}"/></td><td class="p-3"><c:out value="${c.address}"/></td><td class="p-3">${c.status}</td><td class="p-3"><a href="?tab=customers&amp;edit=${c.customerId}" class="mr-3 text-indigo-600">Sửa</a><c:if test="${c.status=='ACTIVE'}"><form method="post" class="inline"><input type="hidden" name="tab" value="customers"><input type="hidden" name="action" value="deactivateCustomer"><input type="hidden" name="customerId" value="${c.customerId}"><button class="text-xs text-rose-600" onclick="return confirm('Ngừng sử dụng khách hàng này?')">Ngừng dùng</button></form></c:if></td></tr></c:forEach></tbody></table></div></section></c:if>
</main></div></div></body></html>
