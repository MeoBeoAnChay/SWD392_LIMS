<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %><%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions" %><!doctype html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Dashboard kho | LIMS</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"></head><body class="bg-slate-50 text-slate-800"><c:set var="activeWarehouseMenu" value="dashboard"/><%@ include file="warehouse-shell.jspf" %><main class="mx-auto w-full max-w-7xl space-y-6 px-4 py-6 sm:px-6 sm:py-8">
<div><p class="text-xs font-bold uppercase tracking-wider text-amber-700">Warehouse / Tổng quan</p><h1 class="mt-1 text-2xl font-bold">Dashboard công việc</h1><p class="mt-1 text-sm text-slate-500">Theo dõi các phiếu được giao, công việc đang chờ và những phiếu đã gửi Manager.</p></div><c:if test="${not empty notice}"><div class="rounded-lg border border-emerald-200 bg-emerald-50 p-3 text-sm text-emerald-800"><c:out value="${notice}"/></div></c:if><c:if test="${not empty error}"><div class="rounded-lg border border-rose-200 bg-rose-50 p-3 text-sm text-rose-700"><c:out value="${error}"/></div></c:if>
<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4"><a href="${pageContext.request.contextPath}/app/warehouse/handovers" class="rounded-2xl border bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"><div class="flex items-center justify-between text-sm text-slate-500"><span>Bàn giao được giao</span><i class="fa-solid fa-boxes-stacked text-amber-600"></i></div><p class="mt-3 text-3xl font-bold">${fn:length(handovers)}</p><span class="mt-2 inline-block text-xs font-semibold text-amber-700">Xem tiếp nhận hàng →</span></a><a href="${pageContext.request.contextPath}/app/warehouse/export-requests" class="rounded-2xl border bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"><div class="flex items-center justify-between text-sm text-slate-500"><span>Đơn xuất được giao</span><i class="fa-solid fa-truck-ramp-box text-indigo-600"></i></div><p class="mt-3 text-3xl font-bold">${fn:length(exportRequests)}</p><span class="mt-2 inline-block text-xs font-semibold text-indigo-700">Soạn hàng theo serial →</span></a><a href="${pageContext.request.contextPath}/app/warehouse/stocktakes" class="rounded-2xl border bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"><div class="flex items-center justify-between text-sm text-slate-500"><span>Đợt kiểm kho được giao</span><i class="fa-solid fa-clipboard-list text-violet-600"></i></div><p class="mt-3 text-3xl font-bold">${fn:length(stocktakes)}</p><span class="mt-2 inline-block text-xs font-semibold text-violet-700">Mở danh sách kiểm kho →</span></a><a href="${pageContext.request.contextPath}/app/warehouse/export-requests" class="rounded-2xl border bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"><div class="flex items-center justify-between text-sm text-slate-500"><span>Phiếu xuất đã gửi</span><i class="fa-solid fa-paper-plane text-emerald-600"></i></div><p class="mt-3 text-3xl font-bold">${fn:length(exportReceipts)}</p><span class="mt-2 inline-block text-xs font-semibold text-emerald-700">Theo dõi Manager duyệt →</span></a></div>
<div class="grid gap-3 sm:grid-cols-2"><a href="${pageContext.request.contextPath}/app/warehouse/import-history" class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm font-semibold text-amber-800"><i class="fa-solid fa-clock-rotate-left mr-2"></i>Lịch sử nhập kho</a><a href="${pageContext.request.contextPath}/app/warehouse/export-history" class="rounded-xl border border-indigo-200 bg-indigo-50 px-4 py-3 text-sm font-semibold text-indigo-800"><i class="fa-solid fa-clock-rotate-left mr-2"></i>Lịch sử xuất kho</a></div><div class="grid gap-6 xl:grid-cols-2"><section class="overflow-hidden rounded-2xl border bg-white shadow-sm"><div class="flex items-center justify-between border-b p-5"><div><h2 class="font-semibold">Tiếp nhận hàng</h2><p class="mt-1 text-xs text-slate-500">Đối chiếu phiếu bàn giao, kiểm đếm và lập phiếu nhập.</p></div><a href="${pageContext.request.contextPath}/app/warehouse/handovers" class="text-sm font-semibold text-amber-700">Danh sách →</a></div><div class="divide-y"><c:forEach var="h" items="${handovers}"><div class="flex flex-wrap items-center justify-between gap-3 p-4"><div><p class="font-medium">Phiếu bàn giao #${h.handoverId} · PO #${h.requestId}</p><p class="mt-1 text-xs text-slate-500"><c:out value="${h.supplierName}"/> · ${h.handoverQuantity} máy · ${h.receiptStatus}</p></div><c:if test="${h.receiptStatus == 'WAITING' or h.receiptStatus == 'REJECTED'}"><a href="${pageContext.request.contextPath}/app/warehouse/import-receipt-form?handoverId=${h.handoverId}" class="rounded-lg bg-amber-600 px-3 py-2 text-xs font-semibold text-white">Lập phiếu nhập</a></c:if></div></c:forEach><c:if test="${empty handovers}"><p class="p-8 text-center text-sm text-slate-500">Không có phiếu bàn giao được giao.</p></c:if></div></section>
<section class="overflow-hidden rounded-2xl border bg-white shadow-sm"><div class="flex items-center justify-between border-b p-5"><div><h2 class="font-semibold">Soạn hàng xuất</h2><p class="mt-1 text-xs text-slate-500">Chọn đúng serial, lập phiếu xuất và theo dõi duyệt.</p></div><a href="${pageContext.request.contextPath}/app/warehouse/export-requests" class="text-sm font-semibold text-indigo-700">Danh sách →</a></div><div class="divide-y"><c:forEach var="r" items="${exportRequests}"><div class="flex flex-wrap items-center justify-between gap-3 p-4"><div><p class="font-medium">Yêu cầu #${r.requestId} · <c:out value="${r.customerName}"/></p><p class="mt-1 text-xs text-slate-500"><fmt:formatDate value="${r.requestDate}" pattern="dd/MM/yyyy HH:mm"/> · ${fn:length(r.items)} dòng hàng</p></div><a href="${pageContext.request.contextPath}/app/warehouse/export-form?requestId=${r.requestId}" class="rounded-lg bg-indigo-600 px-3 py-2 text-xs font-semibold text-white">Chọn serial</a></div></c:forEach><c:if test="${empty exportRequests}"><p class="p-8 text-center text-sm text-slate-500">Không có đơn xuất đang chờ soạn.</p></c:if></div></section>
<section class="overflow-hidden rounded-2xl border bg-white shadow-sm"><div class="flex items-center justify-between border-b p-5"><div><h2 class="font-semibold">Kiểm kê được giao</h2><p class="mt-1 text-xs text-slate-500">Ghi nhận serial, tình trạng và vị trí thực tế.</p></div><a href="${pageContext.request.contextPath}/app/warehouse/stocktakes" class="text-sm font-semibold text-violet-700">Danh sách →</a></div><div class="divide-y"><c:forEach var="check" items="${stocktakes}"><div class="flex flex-wrap items-center justify-between gap-3 p-4"><div><p class="font-medium">Đợt kiểm kho #${check.checkId} · ${check.status}</p><p class="mt-1 text-xs text-slate-500">Khu vực: <c:out value="${empty check.locationFilter ? 'Toàn kho' : check.locationFilter}"/> · <fmt:formatDate value="${check.checkDate}" pattern="dd/MM/yyyy"/></p></div><c:if test="${check.status == 'ASSIGNED' or check.status == 'REJECTED'}"><a href="${pageContext.request.contextPath}/app/warehouse/stocktake-form?checkId=${check.checkId}" class="rounded-lg bg-violet-600 px-3 py-2 text-xs font-semibold text-white">Tiến hành</a></c:if></div></c:forEach><c:if test="${empty stocktakes}"><p class="p-8 text-center text-sm text-slate-500">Không có đợt kiểm kho được giao.</p></c:if></div></section>
<section class="overflow-hidden rounded-2xl border bg-white shadow-sm"><div class="border-b p-5"><h2 class="font-semibold">Phiếu xuất đã gửi Manager</h2><p class="mt-1 text-xs text-slate-500">Theo dõi phê duyệt và kết quả phiếu xuất.</p></div><div class="divide-y"><c:forEach var="receipt" items="${exportReceipts}"><div class="p-4"><p class="font-medium">Phiếu xuất #${receipt.receiptId} · Yêu cầu #${receipt.requestId} · ${receipt.status}</p><c:if test="${receipt.status == 'REJECTED'}"><p class="mt-1 text-xs text-rose-700"><c:out value="${receipt.cancelReason}"/></p></c:if><p class="mt-1 text-xs text-slate-500"><c:forEach var="item" items="${receipt.items}"><span class="mr-2"><c:out value="${item.productCode}"/> / <c:out value="${item.serialNumber}"/></span></c:forEach></p></div></c:forEach><c:if test="${empty exportReceipts}"><p class="p-8 text-center text-sm text-slate-500">Chưa gửi phiếu xuất nào.</p></c:if></div></section></div>
</main></div></div></body></html>



