<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" language="java" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Duyệt đơn mua hàng | LIMS Manager</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"></head><body class="bg-slate-50 text-slate-800"><c:set var="activeManagerMenu" value="requests"/><%@ include file="manager-shell.jspf" %><main class="mx-auto max-w-7xl space-y-6 px-4 py-6 sm:px-6 sm:py-8"><div class="flex flex-wrap items-end justify-between gap-3"><div><h1 class="text-2xl font-bold">Duyệt đơn mua hàng</h1><p class="mt-1 text-sm text-slate-500">Duyệt đơn trước khi nhà cung cấp giao hàng. Tồn kho chỉ được cập nhật khi Warehouse Staff tiếp nhận và đăng ký serial.</p></div><form method="get" action="${pageContext.request.contextPath}/app/manager/import-requests"><select name="status" onchange="this.form.submit()" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm"><c:forEach var="state" items="${requestStatuses}"><option value="${state}" ${statusFilter == state ? 'selected' : ''}>${state == 'ALL' ? 'Tất cả trạng thái' : state}</option></c:forEach></select></form></div>
<c:if test="${not empty notice}"><div class="rounded-lg border border-emerald-200 bg-emerald-50 p-3 text-sm text-emerald-800"><c:out value="${notice}"/></div></c:if><c:if test="${not empty error}"><div class="rounded-lg border border-rose-200 bg-rose-50 p-3 text-sm text-rose-700"><c:out value="${error}"/></div></c:if>
<c:forEach var="order" items="${requests}"><article class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm"><div class="flex flex-wrap items-start justify-between gap-4 border-b border-slate-100 p-4 sm:p-5"><div><div class="flex flex-wrap items-center gap-2"><h2 class="text-lg font-bold">Đơn #${order.requestId}</h2><span class="rounded-full px-2.5 py-1 text-xs font-semibold ${order.status == 'PENDING' ? 'bg-amber-100 text-amber-800' : order.status == 'APPROVED' ? 'bg-emerald-100 text-emerald-800' : order.status == 'REJECTED' ? 'bg-rose-100 text-rose-800' : order.status == 'COMPLETED' ? 'bg-blue-100 text-blue-800' : 'bg-slate-100 text-slate-700'}"><c:out value="${order.status}"/></span></div><p class="mt-1 text-sm text-slate-600"><b>Nhà cung cấp:</b> <c:out value="${order.supplierName}"/> · <fmt:formatDate value="${order.requestDate}" pattern="dd/MM/yyyy HH:mm"/></p><p class="mt-1 text-xs text-slate-500">Người tạo: <c:out value="${order.createdByName}"/> · Tổng số lượng: ${order.orderedQuantity} máy</p></div><c:if test="${order.status == 'PENDING'}"><span class="rounded-full bg-amber-50 px-3 py-1.5 text-xs font-bold text-amber-700"><i class="fa-regular fa-clock mr-1"></i>Chờ quyết định</span></c:if></div>
<div class="overflow-x-auto px-4 py-3 sm:px-5"><table class="min-w-full text-left text-sm"><thead class="text-xs uppercase text-slate-500"><tr><th class="py-2 pr-4">Mã sản phẩm</th><th class="py-2 pr-4">Tên model</th><th class="py-2 pr-4">Số lượng</th><th class="py-2 pr-4">Đơn giá</th></tr></thead><tbody class="divide-y divide-slate-100"><c:forEach var="item" items="${order.items}"><tr><td class="py-2 pr-4"><c:out value="${item.productCode}"/></td><td class="py-2 pr-4"><c:out value="${item.productName}"/></td><td class="py-2 pr-4">${item.quantity}</td><td class="whitespace-nowrap py-2 pr-4"><fmt:formatNumber value="${item.unitPrice}" pattern="#,##0.00"/> ₫</td></tr></c:forEach></tbody></table></div>
<c:if test="${order.status == 'PENDING'}"><div class="flex flex-wrap items-start gap-3 border-t border-slate-100 bg-slate-50/70 p-4 sm:px-5"><form method="post" action="${pageContext.request.contextPath}/app/manager/import-requests"><input type="hidden" name="requestId" value="${order.requestId}"><input type="hidden" name="decision" value="APPROVED"><button class="rounded-lg bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-emerald-700"><i class="fa-solid fa-check mr-2"></i>Duyệt đơn</button></form><form method="post" action="${pageContext.request.contextPath}/app/manager/import-requests" class="flex min-w-[280px] flex-1 gap-2"><input type="hidden" name="requestId" value="${order.requestId}"><input type="hidden" name="decision" value="REJECTED"><input name="reason" maxlength="255" required placeholder="Lý do từ chối đơn" class="min-w-0 flex-1 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm"><button class="rounded-lg border border-rose-200 bg-white px-4 py-2.5 text-sm font-semibold text-rose-700 hover:bg-rose-50"><i class="fa-solid fa-xmark mr-1"></i>Từ chối</button></form></div></c:if>
<c:if test="${order.status == 'REJECTED'}"><div class="border-t border-rose-100 bg-rose-50/50 px-5 py-3 text-sm"><b>Lý do từ chối:</b> <c:out value="${order.cancelReason}"/><span class="ml-2 text-xs text-slate-500">· <c:out value="${order.approvedByName}"/> · <fmt:formatDate value="${order.approvedDate}" pattern="dd/MM/yyyy HH:mm"/></span></div></c:if><c:if test="${order.status == 'APPROVED' or order.status == 'COMPLETED'}"><div class="border-t border-emerald-100 bg-emerald-50/50 px-5 py-3 text-sm">Được duyệt bởi <b><c:out value="${order.approvedByName}"/></b> · <fmt:formatDate value="${order.approvedDate}" pattern="dd/MM/yyyy HH:mm"/>. Purchasing Staff có thể lập phiếu bàn giao; kho sẽ ghi nhận tồn sau khi nhận hàng và đăng ký serial.</div></c:if>
</article></c:forEach><c:if test="${empty requests}"><div class="rounded-xl border border-dashed border-slate-300 bg-white px-4 py-14 text-center text-slate-500">Không có đơn hàng ở trạng thái này.</div></c:if></main></div></div></body></html>
