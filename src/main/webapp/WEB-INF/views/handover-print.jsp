<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" language="java" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Phiếu bàn giao #${handover.handoverId} | LIMS</title><style>
*{box-sizing:border-box}body{margin:0;background:#eef2f7;color:#111827;font:14px Arial,sans-serif}.toolbar{max-width:900px;margin:20px auto;display:flex;justify-content:space-between;gap:12px}.toolbar a,.toolbar button{border:0;border-radius:6px;padding:10px 16px;background:#047857;color:#fff;text-decoration:none;font-weight:700;cursor:pointer}.toolbar a{background:#475569}.paper{width:min(900px,calc(100% - 32px));margin:0 auto 32px;padding:42px 48px;background:#fff;box-shadow:0 8px 28px #0f172a18}.center{text-align:center}.muted{color:#475569}.topline{display:flex;justify-content:space-between;border-bottom:1px solid #cbd5e1;padding-bottom:16px}.topline h1{font-size:22px;margin:0 0 5px}.section-title{margin:22px 0 10px;font-size:15px;font-weight:700}.grid{display:grid;grid-template-columns:1fr 1fr;gap:9px 24px}.field{border-bottom:1px dotted #9ca3af;padding:7px 0}.field b{font-weight:600}.people{display:grid;grid-template-columns:1fr 1fr;gap:28px}.person{border:1px solid #cbd5e1;padding:14px;border-radius:6px}.person h3{font-size:13px;text-align:center;margin:0 0 12px}.table{width:100%;border-collapse:collapse}.table th,.table td{border:1px solid #64748b;padding:7px;text-align:left}.table th{background:#f1f5f9;text-align:center}.table .serial{min-width:140px;height:30px}.checks{display:flex;flex-wrap:wrap;gap:8px 18px}.signatures{display:grid;grid-template-columns:1fr 1fr;text-align:center;gap:30px;margin-top:12px}.signatures .space{height:90px}.note{border:1px solid #cbd5e1;min-height:62px;padding:10px;white-space:pre-wrap}.print-footer{text-align:center;color:#64748b;font-size:11px;margin-top:20px}
@media print{body{background:#fff}.toolbar{display:none}.paper{width:100%;margin:0;padding:12mm 14mm;box-shadow:none}.section-title{break-after:avoid}.table tr{break-inside:avoid}@page{size:A4;margin:10mm}}
@media(max-width:600px){.paper{padding:22px 16px}.grid,.people,.signatures{grid-template-columns:1fr}.table{font-size:12px}}
</style></head><body><div class="toolbar"><a href="${pageContext.request.contextPath}/app/purchasing/handovers">← Danh sách bàn giao</a><button type="button" onclick="window.print()"><i>▤</i> In phiếu bàn giao</button></div>
<main class="paper"><header class="topline"><div><h1>PHIẾU BÀN GIAO HÀNG HÓA</h1><div class="muted">LAPTOP INVENTORY MANAGEMENT SYSTEM</div></div><div class="center"><b>Số: <fmt:formatNumber value="${handover.handoverId}" minIntegerDigits="6" groupingUsed="false"/>/BBBG</b><div class="muted" style="margin-top:6px">Trạng thái: ${handover.receiptStatus == 'COMPLETED' ? 'Đã nhập kho' : handover.receiptStatus == 'PENDING_APPROVAL' ? 'Chờ Manager duyệt phiếu nhập' : handover.receiptStatus == 'REJECTED' ? 'Phiếu nhập bị từ chối' : handover.receiptStatus == 'PROCESSING' ? 'Đang kiểm đếm' : 'Chờ kho tiếp nhận'}</div></div></header>
<h2 class="section-title">I. THÔNG TIN BÀN GIAO</h2><div class="grid"><div class="field"><b>Ngày bàn giao:</b> <fmt:formatDate value="${handover.handoverDate}" pattern="dd/MM/yyyy"/></div><div class="field"><b>Địa điểm bàn giao:</b> <c:out value="${handover.location}"/></div><div class="field"><b>Mã đơn đặt hàng (PO):</b> #${handover.requestId}</div><div class="field"><b>Mã phiếu nhập:</b> <c:choose><c:when test="${not empty handover.importReceiptId}">#${handover.importReceiptId}</c:when><c:otherwise>Chưa lập - kho cập nhật khi tiếp nhận</c:otherwise></c:choose></div><div class="field"><b>Thời gian:</b> <fmt:formatDate value="${handover.handoverDate}" pattern="HH:mm"/></div><div class="field"><b>Tổng số kiện/thùng:</b> <c:out value="${handover.packageCount}"/></div><div class="field"><b>Nhà cung cấp:</b> <c:out value="${handover.supplierName}"/></div><div class="field"><b>Tổng số lượng:</b> ${handover.handoverQuantity}</div></div>
<h2 class="section-title">II. THÔNG TIN NGƯỜI BÀN GIAO VÀ TIẾP NHẬN</h2><div class="people"><div class="person"><h3>NGƯỜI BÀN GIAO</h3><div class="field"><b>Họ và tên:</b> <c:out value="${user.fullName}"/></div><div class="field"><b>Bộ phận:</b> Purchasing Staff</div><div class="field"><b>Chức vụ:</b> Nhân viên mua hàng</div><div class="field"><b>Người giao hàng / đơn vị vận chuyển:</b> <c:out value="${handover.handoverBy}"/></div></div><div class="person"><h3>NGƯỜI TIẾP NHẬN</h3><div class="field"><b>Họ và tên:</b> <c:out value="${handover.receiverName}"/></div><div class="field"><b>Bộ phận:</b> Warehouse Staff</div><div class="field"><b>Chức vụ:</b> Nhân viên kho</div></div></div>
<h2 class="section-title">III. DANH SÁCH HÀNG HÓA BÀN GIAO</h2><table class="table"><thead><tr><th>STT</th><th>Tên sản phẩm / Model</th><th>Mã sản phẩm</th><th>Serial Number</th><th>Số lượng</th><th>Ghi chú</th></tr></thead><tbody><c:set var="rowNumber" value="0"/><c:forEach var="item" items="${handover.items}"><c:forEach var="unit" begin="1" end="${item.quantity}"><c:set var="rowNumber" value="${rowNumber + 1}"/><tr><td class="center">${rowNumber}</td><td><c:out value="${item.productName}"/></td><td><c:out value="${item.productCode}"/></td><td class="serial"></td><td class="center">1</td><td></td></tr></c:forEach></c:forEach><tr><td colspan="4" style="text-align:right"><b>TỔNG SỐ LƯỢNG</b></td><td class="center"><b>${handover.handoverQuantity}</b></td><td></td></tr></tbody></table>
<h2 class="section-title">IV. TÌNH TRẠNG BÀN GIAO VÀ KIỂM TRA</h2><div class="checks"><span>${handover.goodsIntact ? '☒' : '☐'} Hàng hóa đầy đủ, nguyên vẹn</span><span>${handover.quantityDiscrepancy ? '☒' : '☐'} Sai lệch số lượng</span><span>${handover.damaged ? '☒' : '☐'} Hư hỏng</span><span>${handover.serialDiscrepancy ? '☒' : '☐'} Sai lệch Serial Number</span></div><p><b>Ghi chú / Mô tả sai lệch:</b></p><div class="note"><c:out value="${handover.note}"/></div>
<h2 class="section-title">V. XÁC NHẬN BÀN GIAO</h2><p>Hai bên xác nhận đã thực hiện việc bàn giao và tiếp nhận hàng hóa theo thông tin ghi trên phiếu. Các sai lệch (nếu có) đã được ghi nhận tại Mục IV.</p><p class="center">Ngày ...... tháng ...... năm ........</p><div class="signatures"><div><b>NGƯỜI BÀN GIAO</b><br><span class="muted">(Ký và ghi rõ họ tên)</span><div class="space"></div><c:out value="${user.fullName}"/></div><div><b>NGƯỜI TIẾP NHẬN</b><br><span class="muted">(Ký và ghi rõ họ tên)</span><div class="space"></div><c:out value="${handover.receiverName}"/></div></div><div class="print-footer">Phiếu bàn giao #${handover.handoverId} · LIMS</div></main></body></html>
