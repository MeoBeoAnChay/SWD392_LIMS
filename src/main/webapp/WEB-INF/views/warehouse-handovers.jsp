<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" language="java" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Tiếp nhận hàng | LIMS Warehouse</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"></head><body class="bg-slate-50 text-slate-800"><div class="min-h-screen lg:flex"><aside class="hidden w-64 shrink-0 border-r border-slate-200 bg-white lg:flex lg:flex-col"><a href="${pageContext.request.contextPath}/app/warehouse/handovers" class="flex h-16 items-center gap-3 border-b border-slate-100 px-5 font-bold"><span class="flex h-10 w-10 items-center justify-center rounded-xl bg-amber-600 text-white"><i class="fa-solid fa-warehouse"></i></span><span>LIMS<span class="block text-xs font-normal text-slate-500">Warehouse Staff</span></span></a><nav class="flex-1 space-y-1 p-3"><a href="${pageContext.request.contextPath}/app/warehouse/handovers" class="flex items-center gap-3 rounded-lg bg-amber-50 px-3 py-2.5 text-sm font-semibold text-amber-700"><i class="fa-solid fa-truck-ramp-box w-5"></i> Phiếu chờ tiếp nhận</a><a href="${pageContext.request.contextPath}/app/warehouse/stocktakes" class="mt-1 flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm text-slate-600 hover:bg-slate-50"><i class="fa-solid fa-clipboard-list w-5"></i> Kiểm kho</a><a href="${pageContext.request.contextPath}/app/warehouse/export-requests" class="mt-1 flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm text-slate-600 hover:bg-slate-50"><i class="fa-solid fa-box-open w-5"></i> Soạn hàng xuất</a></nav><div class="border-t border-slate-100 p-4 text-xs text-slate-500"><c:out value="${user.fullName}"/><br/>Warehouse Staff</div></aside><div class="min-w-0 flex-1"><header class="flex h-16 items-center justify-between border-b border-slate-200 bg-white px-4 sm:px-6"><div class="font-semibold">Tiếp nhận hàng hóa</div><div class="flex items-center gap-3 text-sm"><span class="hidden text-slate-500 sm:inline"><c:out value="${user.fullName}"/></span><a class="text-rose-600" href="${pageContext.request.contextPath}/logout">Đăng xuất</a></div></header><main class="mx-auto max-w-7xl space-y-6 px-4 py-6 sm:px-6 sm:py-8"><div><h1 class="text-2xl font-bold">Phiếu bàn giao được giao cho tôi</h1><p class="mt-1 text-sm text-slate-500">Đối chiếu phiếu giấy đã ký, quét serial, sắp xếp máy vào vị trí kho rồi gửi phiếu nhập cho Manager duyệt.</p></div><c:if test="${not empty notice}"><div class="rounded-lg border border-emerald-200 bg-emerald-50 p-3 text-sm text-emerald-800"><c:out value="${notice}"/></div></c:if><c:if test="${not empty error}"><div class="rounded-lg border border-rose-200 bg-rose-50 p-3 text-sm text-rose-700"><c:out value="${error}"/></div></c:if>
<div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm"><div class="overflow-x-auto"><table class="min-w-full text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="px-4 py-3">Phiếu bàn giao</th><th class="px-4 py-3">Đơn mua / Nhà cung cấp</th><th class="px-4 py-3">Ngày nhận</th><th class="px-4 py-3">Người mua hàng</th><th class="px-4 py-3">Số lượng</th><th class="px-4 py-3">Trạng thái</th><th class="px-4 py-3">Thao tác</th></tr></thead><tbody class="divide-y divide-slate-100"><c:forEach var="handover" items="${handovers}"><tr><td class="px-4 py-4 font-semibold">#${handover.handoverId}</td><td class="px-4 py-4">PO #${handover.requestId}<div class="text-xs text-slate-500"><c:out value="${handover.supplierName}"/></div></td><td class="whitespace-nowrap px-4 py-4"><fmt:formatDate value="${handover.handoverDate}" pattern="dd/MM/yyyy HH:mm"/><div class="text-xs text-slate-500"><c:out value="${handover.location}"/></div></td><td class="px-4 py-4"><c:out value="${handover.purchasingStaffName}"/></td><td class="px-4 py-4">${handover.handoverQuantity} máy</td><td class="px-4 py-4"><span class="rounded-full px-2.5 py-1 text-xs font-semibold ${handover.receiptStatus == 'COMPLETED' ? 'bg-emerald-100 text-emerald-800' : handover.receiptStatus == 'PENDING_MANAGER' ? 'bg-indigo-100 text-indigo-800' : handover.receiptStatus == 'REJECTED' ? 'bg-rose-100 text-rose-800' : 'bg-amber-100 text-amber-800'}">${handover.receiptStatus == 'COMPLETED' ? 'Đã nhập kho' : handover.receiptStatus == 'PENDING_MANAGER' ? 'Chờ Manager duyệt' : handover.receiptStatus == 'REJECTED' ? 'Manager từ chối' : 'Chờ tiếp nhận'}</span><c:if test="${handover.receiptStatus == 'REJECTED' and not empty handover.rejectReason}"><div class="mt-1 max-w-xs text-xs text-rose-700"><c:out value="${handover.rejectReason}"/></div></c:if></td><td class="px-4 py-4"><c:if test="${handover.receiptStatus == 'WAITING' or handover.receiptStatus == 'REJECTED'}"><a href="${pageContext.request.contextPath}/app/warehouse/import-receipt-form?handoverId=${handover.handoverId}" class="whitespace-nowrap rounded-lg bg-amber-600 px-3 py-2 text-xs font-semibold text-white">Lập phiếu nhập kho</a></c:if></td></tr></c:forEach><c:if test="${empty handovers}"><tr><td colspan="7" class="px-4 py-12 text-center text-slate-500">Chưa có phiếu bàn giao nào được giao cho tài khoản này.</td></tr></c:if></tbody></table></div></div></main></div></div></body></html>
