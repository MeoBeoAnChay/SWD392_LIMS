<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<div class="min-h-screen bg-slate-50 lg:flex">
    <!-- Admin Sidebar -->
    <aside class="hidden w-72 shrink-0 flex-col bg-slate-950 text-slate-200 lg:flex border-r border-slate-800">
        <!-- Logo -->
        <a href="${pageContext.request.contextPath}/app/admin/users" class="flex h-20 items-center gap-3 border-b border-white/10 px-6 transition hover:bg-white/[0.02]">
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-blue-600 text-lg text-white shadow-lg shadow-blue-900/40">
                <i class="fa-solid fa-laptop"></i>
            </span>
            <div>
                <span class="text-lg font-bold tracking-wide text-white">LIMS</span>
                <span class="block text-xs font-medium text-blue-400">Admin Console</span>
            </div>
        </a>

        <!-- Navigation -->
        <nav class="flex-1 space-y-1.5 overflow-y-auto px-4 py-6">
            <p class="px-3 pb-2 text-[10px] font-bold uppercase tracking-[0.18em] text-slate-500">QUẢN TRỊ HỆ THỐNG</p>
            <a href="${pageContext.request.contextPath}/app/admin/users" 
               class="flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-sm transition ${tab == 'users' ? 'bg-blue-600 font-semibold text-white shadow-md shadow-blue-900/30' : 'text-slate-300 hover:bg-white/5 hover:text-white'}">
                <i class="fa-solid fa-users-gear w-5 text-center ${tab == 'users' ? 'text-white' : 'text-slate-400'}"></i>
                <span>Người dùng & Phân quyền</span>
            </a>
            <a href="${pageContext.request.contextPath}/app/admin/audit" 
               class="flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-sm transition ${tab == 'audit' ? 'bg-blue-600 font-semibold text-white shadow-md shadow-blue-900/30' : 'text-slate-300 hover:bg-white/5 hover:text-white'}">
                <i class="fa-solid fa-shield-halved w-5 text-center ${tab == 'audit' ? 'text-white' : 'text-slate-400'}"></i>
                <span>Nhật ký Audit Log</span>
            </a>
        </nav>

        <!-- Current User Card in Sidebar -->
        <div class="border-t border-white/10 p-4">
            <div class="flex items-center gap-3 rounded-xl bg-white/5 p-3">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-blue-500/20 text-blue-300">
                    <i class="fa-solid fa-user-shield"></i>
                </span>
                <div class="min-w-0">
                    <p class="truncate text-sm font-semibold text-white"><c:out value="${sessionScope.LOGIN_USER.fullName}"/></p>
                    <p class="mt-0.5 text-xs text-blue-400 font-medium">Administrator</p>
                </div>
                <a href="${pageContext.request.contextPath}/logout" title="Đăng xuất" 
                   class="ml-auto rounded-lg p-2 text-slate-400 transition hover:bg-rose-500/10 hover:text-rose-300">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                </a>
            </div>
        </div>
    </aside>

    <!-- Main Wrapper -->
    <div class="flex min-w-0 flex-1 flex-col">
        <!-- Top Header -->
        <header class="sticky top-0 z-20 flex h-16 items-center justify-between border-b border-slate-200 bg-white/95 px-4 shadow-sm backdrop-blur sm:px-6 lg:px-8">
            <div class="flex items-center gap-3">
                <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-blue-50 text-blue-600 lg:hidden">
                    <i class="fa-solid fa-laptop"></i>
                </span>
                <div>
                    <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-slate-400">LIMS / Admin Console</p>
                    <p class="text-sm font-semibold text-slate-800">
                        <c:out value="${tab == 'audit' ? 'Nhật ký kiểm toán hệ thống' : 'Quản lý tài khoản & Phân quyền'}"/>
                    </p>
                </div>
            </div>

            <div class="flex items-center gap-3">
                <span class="hidden text-sm font-medium text-slate-600 sm:inline">
                    <c:out value="${sessionScope.LOGIN_USER.fullName}"/>
                </span>
                <a href="${pageContext.request.contextPath}/logout" 
                   class="inline-flex items-center gap-2 rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-600 transition hover:border-rose-200 hover:bg-rose-50 hover:text-rose-700">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                    <span class="hidden sm:inline">Đăng xuất</span>
                </a>
            </div>
        </header>

        <!-- Mobile Navigation Strip -->
        <div class="border-b border-slate-200 bg-white px-4 py-2.5 lg:hidden flex gap-2">
            <a href="${pageContext.request.contextPath}/app/admin/users" class="rounded-lg px-3 py-1.5 text-xs font-medium ${tab == 'users' ? 'bg-blue-600 text-white' : 'bg-slate-100 text-slate-700'}">Người dùng</a>
            <a href="${pageContext.request.contextPath}/app/admin/audit" class="rounded-lg px-3 py-1.5 text-xs font-medium ${tab == 'audit' ? 'bg-blue-600 text-white' : 'bg-slate-100 text-slate-700'}">Audit Log</a>
        </div>
