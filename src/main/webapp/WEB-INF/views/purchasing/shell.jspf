<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<div class="min-h-screen bg-slate-50 lg:flex">
    <!-- Purchasing Sidebar -->
    <aside class="hidden w-72 shrink-0 flex-col bg-slate-950 text-slate-200 lg:flex border-r border-slate-800">
        <a href="${pageContext.request.contextPath}/app/purchasing/dashboard" class="flex h-20 items-center gap-3 border-b border-white/10 px-6 transition hover:bg-white/[0.02]">
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-600 text-lg text-white shadow-lg shadow-emerald-950/40">
                <i class="fa-solid fa-cart-shopping"></i>
            </span>
            <div>
                <span class="text-lg font-bold tracking-wide text-white">LIMS</span>
                <span class="block text-xs font-medium text-emerald-400">Purchasing Staff</span>
            </div>
        </a>

        <nav class="flex-1 space-y-2 overflow-y-auto px-4 py-6">
            <p class="px-3 pb-2 text-[10px] font-bold uppercase tracking-[0.18em] text-slate-500">TỔNG QUAN</p>
            <a href="${pageContext.request.contextPath}/app/purchasing/dashboard" 
               class="flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-sm transition ${activeMenu == 'dashboard' ? 'bg-emerald-600 font-semibold text-white shadow-md shadow-emerald-950/30' : 'text-slate-300 hover:bg-white/5 hover:text-white'}">
                <i class="fa-solid fa-chart-pie w-5 text-center ${activeMenu == 'dashboard' ? 'text-white' : 'text-slate-400'}"></i>
                <span>Báo cáo mua hàng</span>
            </a>

            <p class="px-3 pb-2 pt-5 text-[10px] font-bold uppercase tracking-[0.18em] text-slate-500">ĐƠN MUA HÀNG (PO)</p>
            <a href="${pageContext.request.contextPath}/app/purchasing/requests" 
               class="flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-sm transition ${activeMenu == 'orders' ? 'bg-emerald-600 font-semibold text-white shadow-md shadow-emerald-950/30' : 'text-slate-300 hover:bg-white/5 hover:text-white'}">
                <i class="fa-solid fa-file-invoice-dollar w-5 text-center ${activeMenu == 'orders' ? 'text-white' : 'text-slate-400'}"></i>
                <span>Danh sách đơn hàng</span>
            </a>
            <a href="${pageContext.request.contextPath}/app/purchasing/request-form" 
               class="flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-sm text-slate-300 transition hover:bg-white/5 hover:text-white">
                <i class="fa-solid fa-plus w-5 text-center text-slate-400"></i>
                <span>Tạo đơn mua mới</span>
            </a>

            <p class="px-3 pb-2 pt-5 text-[10px] font-bold uppercase tracking-[0.18em] text-slate-500">BÀN GIAO KHO</p>
            <a href="${pageContext.request.contextPath}/app/purchasing/handovers" 
               class="flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-sm transition ${activeMenu == 'handovers' ? 'bg-emerald-600 font-semibold text-white shadow-md shadow-emerald-950/30' : 'text-slate-300 hover:bg-white/5 hover:text-white'}">
                <i class="fa-solid fa-handshake w-5 text-center ${activeMenu == 'handovers' ? 'text-white' : 'text-slate-400'}"></i>
                <span>Biên bản bàn giao</span>
            </a>

            <p class="px-3 pb-2 pt-5 text-[10px] font-bold uppercase tracking-[0.18em] text-slate-500">ĐỐI TÁC</p>
            <a href="${pageContext.request.contextPath}/app/purchasing/suppliers" 
               class="flex items-center gap-3 rounded-xl px-3.5 py-2.5 text-sm transition ${activeMenu == 'suppliers' ? 'bg-emerald-600 font-semibold text-white shadow-md shadow-emerald-950/30' : 'text-slate-300 hover:bg-white/5 hover:text-white'}">
                <i class="fa-solid fa-building w-5 text-center ${activeMenu == 'suppliers' ? 'text-white' : 'text-slate-400'}"></i>
                <span>Nhà cung cấp</span>
            </a>
        </nav>

        <div class="border-t border-white/10 p-4">
            <div class="flex items-center gap-3 rounded-xl bg-white/5 p-3">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-emerald-400/20 text-emerald-200">
                    <i class="fa-solid fa-user-tag"></i>
                </span>
                <div class="min-w-0">
                    <p class="truncate text-sm font-semibold text-white"><c:out value="${user.fullName}"/></p>
                    <p class="mt-0.5 text-xs text-emerald-400">Purchasing Staff</p>
                </div>
                <a href="${pageContext.request.contextPath}/logout" title="Đăng xuất" 
                   class="ml-auto rounded-lg p-2 text-slate-400 transition hover:bg-rose-500/10 hover:text-rose-300">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                </a>
            </div>
        </div>
    </aside>

    <!-- Main Container -->
    <div class="flex min-w-0 flex-1 flex-col">
        <header class="sticky top-0 z-20 flex h-16 items-center justify-between border-b border-slate-200 bg-white/95 px-4 shadow-sm backdrop-blur sm:px-6 lg:px-8">
            <div class="flex items-center gap-3">
                <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-emerald-50 text-emerald-700 lg:hidden">
                    <i class="fa-solid fa-cart-shopping"></i>
                </span>
                <div>
                    <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-slate-400">LIMS / Purchasing</p>
                    <p class="text-sm font-semibold text-slate-800">
                        <c:out value="${activeMenu == 'dashboard' ? 'Dashboard Mua hàng' : activeMenu == 'orders' ? 'Quản lý đơn mua hàng' : activeMenu == 'handovers' ? 'Biên bản bàn giao kho' : 'Nhà cung cấp'}"/>
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-3">
                <span class="hidden text-sm font-medium text-slate-600 sm:inline"><c:out value="${user.fullName}"/></span>
                <a href="${pageContext.request.contextPath}/logout" class="inline-flex items-center gap-2 rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-600 hover:border-rose-200 hover:bg-rose-50 hover:text-rose-700 transition">
                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                    <span class="hidden sm:inline">Đăng xuất</span>
                </a>
            </div>
        </header>

        <!-- Mobile Navigation Strip -->
        <div class="border-b border-slate-200 bg-white px-4 py-2 lg:hidden flex gap-2 overflow-x-auto text-xs">
            <a class="whitespace-nowrap rounded-lg px-3 py-1.5 ${activeMenu == 'dashboard' ? 'bg-emerald-600 text-white' : 'bg-slate-100 text-slate-700'}" href="${pageContext.request.contextPath}/app/purchasing/dashboard">Dashboard</a>
            <a class="whitespace-nowrap rounded-lg px-3 py-1.5 ${activeMenu == 'orders' ? 'bg-emerald-600 text-white' : 'bg-slate-100 text-slate-700'}" href="${pageContext.request.contextPath}/app/purchasing/requests">Đơn mua</a>
            <a class="whitespace-nowrap rounded-lg px-3 py-1.5 ${activeMenu == 'handovers' ? 'bg-emerald-600 text-white' : 'bg-slate-100 text-slate-700'}" href="${pageContext.request.contextPath}/app/purchasing/handovers">Bàn giao</a>
            <a class="whitespace-nowrap rounded-lg px-3 py-1.5 ${activeMenu == 'suppliers' ? 'bg-emerald-600 text-white' : 'bg-slate-100 text-slate-700'}" href="${pageContext.request.contextPath}/app/purchasing/suppliers">Nhà cung cấp</a>
        </div>
        <main class="mx-auto max-w-7xl space-y-6 px-4 py-6 sm:px-6 sm:py-8">
            <c:if test="${not empty param.notice}"><div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800 shadow-sm"><c:out value="${param.notice}"/></div></c:if>
            <c:if test="${not empty param.error}"><div class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800 shadow-sm"><c:out value="${param.error}"/></div></c:if>
