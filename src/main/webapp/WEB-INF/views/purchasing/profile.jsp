<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" language="java" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Thông tin cá nhân | LIMS</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"></head><body class="bg-slate-50 text-slate-800"><%@ include file="shell.jspf" %>
<section><div><h1 class="text-2xl font-bold">Thông tin cá nhân</h1><p class="mt-1 text-sm text-slate-500">Thông tin tài khoản và bảo mật đăng nhập.</p></div><div class="grid gap-5 lg:grid-cols-2"><section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><div class="flex items-center gap-3"><div class="flex h-12 w-12 items-center justify-center rounded-full bg-emerald-100 text-emerald-700"><i class="fa-solid fa-user"></i></div><div><h2 class="font-bold"><c:out value="${user.fullName}"/></h2><p class="text-sm text-slate-500">@<c:out value="${user.username}"/></p></div></div><dl class="mt-5 divide-y divide-slate-100 text-sm"><div class="flex justify-between gap-3 py-3"><dt class="text-slate-500">Email</dt><dd class="text-right"><c:out value="${user.email}"/></dd></div><div class="flex justify-between gap-3 py-3"><dt class="text-slate-500">Điện thoại</dt><dd class="text-right"><c:out value="${user.phone}"/></dd></div><div class="flex justify-between gap-3 py-3"><dt class="text-slate-500">Trạng thái</dt><dd><span class="rounded-full bg-emerald-100 px-2 py-1 text-xs font-bold text-emerald-800"><c:out value="${user.status}"/></span></dd></div><div class="flex justify-between gap-3 py-3"><dt class="text-slate-500">Vai trò</dt><dd class="text-right"><c:forEach var="role" items="${user.roles}"><span class="mb-1 inline-block rounded bg-slate-100 px-2 py-1 text-xs"><c:out value="${role.roleName}"/></span></c:forEach></dd></div></dl></section>
<section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><h2 class="font-bold">Đổi mật khẩu</h2><p class="mt-1 text-sm text-slate-500">Mật khẩu mới cần từ 8 đến 72 ký tự.</p><form method="post" action="${pageContext.request.contextPath}/app/purchasing/profile" class="mt-4 space-y-3"><input type="hidden" name="action" value="changePassword"><label class="block text-sm font-medium">Mật khẩu hiện tại<input name="currentPassword" type="password" required autocomplete="current-password" class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2.5"></label><label class="block text-sm font-medium">Mật khẩu mới<input name="newPassword" type="password" required minlength="8" maxlength="72" autocomplete="new-password" class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2.5"></label><label class="block text-sm font-medium">Nhập lại mật khẩu mới<input name="confirmPassword" type="password" required minlength="8" maxlength="72" autocomplete="new-password" class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2.5"></label><button class="rounded-lg bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white">Cập nhật mật khẩu</button></form></section></div></section>
</main></div></div></body></html>
