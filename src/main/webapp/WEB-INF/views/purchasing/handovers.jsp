<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" language="java" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Danh sách bàn giao | LIMS</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"></head><body class="bg-slate-50 text-slate-800"><%@ include file="shell.jspf" %>
<section class="space-y-5"><div class="flex flex-wrap items-end justify-between gap-3"><div><h1 class="text-2xl font-bold">Danh sách phiếu bàn giao</h1><p class="mt-1 text-sm text-slate-500">Theo dõi phiếu giao hàng cho nhân viên kho và in bản xác nhận.</p></div><a href="${pageContext.request.contextPath}/app/purchasing/handover-form" class="rounded-lg bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white"><i class="fa-solid fa-plus mr-2"></i>Lập phiếu bàn giao</a></div>
<c:if test="${not empty notice}"><div class="rounded-lg border border-emerald-200 bg-emerald-50 p-3 text-sm text-emerald-800"><c:out value="${notice}"/></div></c:if><div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm"><div class="overflow-x-auto"><table class="min-w-full text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="px-4 py-3">Phiếu</th><th class="px-4 py-3">Đơn mua / NCC</th><th class="px-4 py-3">Ngày, địa điểm</th><th class="px-4 py-3">Người bàn giao</th><th class="px-4 py-3">Nhân viên kho nhận</th><th class="px-4 py-3">Số lượng</th><th class="px-4 py-3">Tiến độ</th><th class="px-4 py-3">Bản in</th></tr></thead><tbody class="divide-y divide-slate-100"><c:forEach var="handover" items="${handovers}"><tr><td class="whitespace-nowrap px-4 py-4 font-semibold">#<fmt:formatNumber value="${handover.handoverId}" minIntegerDigits="6" groupingUsed="false"/></td><td class="px-4 py-4"><a class="font-semibold text-emerald-700" href="${pageContext.request.contextPath}/app/purchasing/requests?search=${handover.requestId}">PO #${handover.requestId}</a><div class="text-xs text-slate-500"><c:out value="${handover.supplierName}"/></div></td><td class="px-4 py-4"><div class="whitespace-nowrap"><fmt:formatDate value="${handover.handoverDate}" pattern="dd/MM/yyyy HH:mm"/></div><div class="text-xs text-slate-500"><c:out value="${handover.location}"/></div></td><td class="px-4 py-4"><c:out value="${handover.handoverBy}"/></td><td class="px-4 py-4"><c:out value="${handover.receiverName}"/></td><td class="px-4 py-4">${handover.handoverQuantity} máy <div class="text-xs text-slate-500">${handover.receivedQuantity} đã nhập kho</div></td><td class="px-4 py-4"><span class="rounded-full px-2.5 py-1 text-xs font-semibold ${handover.receiptStatus == 'COMPLETED' ? 'bg-emerald-100 text-emerald-800' : handover.receiptStatus == 'PROCESSING' ? 'bg-amber-100 text-amber-800' : handover.receiptStatus == 'PENDING_APPROVAL' ? 'bg-indigo-100 text-indigo-800' : handover.receiptStatus == 'REJECTED' ? 'bg-rose-100 text-rose-800' : 'bg-slate-100 text-slate-700'}">${handover.receiptStatus == 'COMPLETED' ? 'Đã nhập kho' : handover.receiptStatus == 'PENDING_APPROVAL' ? 'Chờ Manager duyệt phiếu nhập' : handover.receiptStatus == 'REJECTED' ? 'Phiếu nhập bị từ chối' : handover.receiptStatus == 'PROCESSING' ? 'Đang kiểm đếm' : 'Chờ kho tiếp nhận'}</span></td><td class="px-4 py-4"><a class="whitespace-nowrap rounded-lg border border-slate-300 px-3 py-2 text-xs font-semibold hover:bg-slate-50" href="${pageContext.request.contextPath}/app/purchasing/handovers?printId=${handover.handoverId}"><i class="fa-solid fa-print mr-1"></i>Xem / In</a></td></tr></c:forEach><c:if test="${empty handovers}"><tr><td colspan="8" class="px-4 py-12 text-center text-slate-500">Chưa có phiếu bàn giao.</td></tr></c:if></tbody></table></div></div></section>
</main></div></div></body></html>
