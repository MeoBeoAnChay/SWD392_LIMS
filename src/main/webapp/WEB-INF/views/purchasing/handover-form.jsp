<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" language="java" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Lập phiếu bàn giao | LIMS</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"></head><body class="bg-slate-50 text-slate-800"><%@ include file="shell.jspf" %>
<section class="space-y-5"><div><a href="${pageContext.request.contextPath}/app/purchasing/handovers" class="text-sm font-medium text-emerald-700">← Danh sách phiếu bàn giao</a><h1 class="mt-2 text-2xl font-bold">Lập phiếu bàn giao hàng hóa</h1><p class="mt-1 text-sm text-slate-500">Tạo phiếu giao lô hàng cho nhân viên kho tiếp nhận; có thể in và ký xác nhận.</p></div>
<c:if test="${not empty error}"><div class="rounded-lg border border-rose-200 bg-rose-50 p-3 text-sm text-rose-700"><c:out value="${error}"/></div></c:if>
<c:if test="${empty importRequest}"><form method="get" action="${pageContext.request.contextPath}/app/purchasing/handover-form" class="max-w-2xl space-y-4 rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><c:choose><c:when test="${empty approvedRequests}"><p class="text-sm text-slate-600">Chưa có đơn mua hàng đã duyệt và còn hàng để bàn giao.</p></c:when><c:otherwise><label class="block text-sm font-semibold">Chọn đơn mua hàng đã được duyệt<select name="requestId" required class="mt-1.5 w-full rounded-lg border border-slate-300 px-3 py-2.5"><option value="">-- Chọn đơn PO --</option><c:forEach var="order" items="${approvedRequests}"><c:if test="${order.remainingQuantity gt 0}"><option value="${order.requestId}">PO #${order.requestId} · <c:out value="${order.supplierName}"/> · Còn ${order.remainingQuantity} máy</option></c:if></c:forEach></select></label><button class="rounded-lg bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white">Tiếp tục lập phiếu</button></c:otherwise></c:choose></form></c:if>
<c:if test="${not empty importRequest}"><form method="post" action="${pageContext.request.contextPath}/app/purchasing/handovers" class="space-y-5"><input type="hidden" name="action" value="handover"><input type="hidden" name="requestId" value="${importRequest.requestId}">
<section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><h2 class="font-bold">I. Thông tin bàn giao</h2><div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3"><div class="rounded-lg bg-slate-50 p-3 text-sm"><span class="text-slate-500">Mã đơn đặt hàng (PO)</span><div class="mt-1 font-semibold">#${importRequest.requestId}</div></div><div class="rounded-lg bg-slate-50 p-3 text-sm"><span class="text-slate-500">Nhà cung cấp</span><div class="mt-1 font-semibold"><c:out value="${importRequest.supplierName}"/></div></div><div class="rounded-lg bg-slate-50 p-3 text-sm"><span class="text-slate-500">Mã phiếu nhập</span><div class="mt-1 text-slate-600">Cấp sau khi kho tiếp nhận</div></div><label class="text-sm font-semibold">Địa điểm bàn giao (Kho hệ thống)<select name="location" required class="mt-1.5 w-full rounded-lg border border-slate-300 bg-white px-3 py-2.5 text-sm"><option value="">-- Chọn vị trí kho có sẵn --</option><c:forEach var="loc" items="${locations}"><option value="<c:out value="${loc}"/>"><c:out value="${loc}"/></option></c:forEach></select></label><label class="text-sm font-semibold">Tổng số kiện/thùng<input name="packageCount" type="number" min="1" required class="mt-1.5 w-full rounded-lg border border-slate-300 px-3 py-2.5" placeholder="Nhập số kiện"></label><div class="rounded-lg bg-slate-50 p-3 text-sm"><span class="text-slate-500">Ngày, giờ lập phiếu</span><div class="mt-1 font-semibold">Tự ghi nhận khi tạo phiếu</div></div></div></section>
<section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><h2 class="font-bold">II. Người bàn giao và người tiếp nhận</h2><div class="mt-4 grid gap-4 md:grid-cols-2"><div class="rounded-lg bg-slate-50 p-3 text-sm"><span class="text-slate-500">Người lập và bàn giao phiếu</span><div class="mt-1 font-semibold"><c:out value="${user.fullName}"/> · Purchasing Staff</div></div><label class="text-sm font-semibold">Người giao hàng / đơn vị vận chuyển<input name="handoverBy" maxlength="100" required class="mt-1.5 w-full rounded-lg border border-slate-300 px-3 py-2.5" placeholder="Tên tài xế hoặc đơn vị vận chuyển"></label><label class="text-sm font-semibold">Nhân viên kho tiếp nhận<select name="receiverId" required class="mt-1.5 w-full rounded-lg border border-slate-300 px-3 py-2.5"><option value="">-- Chọn nhân viên Warehouse Staff --</option><c:forEach var="staff" items="${warehouseStaff}"><option value="${staff.userId}"><c:out value="${staff.fullName}"/> (@<c:out value="${staff.username}"/>)</option></c:forEach></select></label></div></section>
<section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><div><h2 class="font-bold">III. Danh sách hàng hóa bàn giao</h2><p class="mt-1 text-sm text-slate-500">Nhập số lượng thực giao từng model. Serial Number sẽ được nhân viên kho quét khi nhận hàng.</p></div><div class="mt-4 overflow-x-auto"><table class="min-w-full text-left text-sm"><thead class="bg-slate-50 text-xs uppercase text-slate-500"><tr><th class="px-3 py-3">Tên sản phẩm / Model</th><th class="px-3 py-3">Mã sản phẩm</th><th class="px-3 py-3">SL còn bàn giao</th><th class="px-3 py-3">Số lượng giao lần này</th></tr></thead><tbody class="divide-y divide-slate-100"><c:forEach var="item" items="${handoverItems}"><tr><td class="px-3 py-3 font-medium"><c:out value="${item.productName}"/></td><td class="px-3 py-3"><c:out value="${item.productCode}"/><input type="hidden" name="productIds" value="${item.productId}"></td><td class="px-3 py-3">${item.handoverRemainingQuantity}</td><td class="px-3 py-3"><input name="quantities" type="number" min="0" max="${item.handoverRemainingQuantity}" value="${item.handoverRemainingQuantity}" required class="w-32 rounded-lg border border-slate-300 px-3 py-2"></td></tr></c:forEach><c:if test="${empty handoverItems}"><tr><td colspan="4" class="px-3 py-8 text-center text-slate-500">Đơn hàng đã bàn giao hết số lượng.</td></tr></c:if></tbody></table></div></section>
<section class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm"><h2 class="font-bold">IV. Tình trạng bàn giao và kiểm tra</h2><div class="mt-4 flex flex-wrap gap-x-6 gap-y-3 text-sm"><label class="flex items-center gap-2"><input type="checkbox" name="goodsIntact" class="rounded border-slate-300"> Hàng hóa đầy đủ, nguyên vẹn</label><label class="flex items-center gap-2"><input type="checkbox" name="quantityDiscrepancy" class="rounded border-slate-300"> Sai lệch số lượng</label><label class="flex items-center gap-2"><input type="checkbox" name="damaged" class="rounded border-slate-300"> Hư hỏng</label><label class="flex items-center gap-2"><input type="checkbox" name="serialDiscrepancy" class="rounded border-slate-300"> Sai lệch Serial Number</label></div><label class="mt-4 block text-sm font-semibold">Ghi chú / mô tả sai lệch<textarea name="note" maxlength="1000" rows="3" class="mt-1.5 w-full rounded-lg border border-slate-300 px-3 py-2.5" placeholder="Mô tả sai lệch hoặc hư hỏng (nếu có)"></textarea></label></section>
<div class="flex flex-wrap gap-3"><button class="rounded-lg bg-emerald-600 px-5 py-2.5 text-sm font-semibold text-white"><i class="fa-solid fa-file-circle-check mr-2"></i>Tạo phiếu bàn giao</button><a href="${pageContext.request.contextPath}/app/purchasing/handovers" class="rounded-lg border border-slate-300 bg-white px-5 py-2.5 text-sm font-semibold">Hủy</a></div></form></c:if>
</section></main></div></div></body></html>
