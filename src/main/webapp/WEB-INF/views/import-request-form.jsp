<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" language="java" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>${empty importRequest ? 'Tạo đơn mua hàng' : 'Sửa đơn mua hàng'} | LIMS</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"></head><body class="bg-slate-50 text-slate-800"><%@ include file="purchasing-shell.jspf" %>
<section><div><a href="${pageContext.request.contextPath}/app/purchasing/requests" class="text-sm font-medium text-emerald-700">← Danh sách đơn hàng</a><h1 class="mt-2 text-2xl font-bold">${empty importRequest ? 'Tạo đơn mua hàng' : 'Sửa đơn mua hàng'}</h1><p class="mt-1 text-sm text-slate-500">Đơn sẽ được lưu với trạng thái Pending; giá nhập là đơn giá mua đã thỏa thuận.</p></div>
    <c:choose><c:when test="${empty suppliers or empty products}"><div class="rounded-xl border border-amber-200 bg-amber-50 p-5 text-sm text-amber-900">Cần có nhà cung cấp ACTIVE và sản phẩm ACTIVE để tạo đơn.</div></c:when><c:otherwise>
    <form method="post" action="${pageContext.request.contextPath}/app/purchasing/requests" class="space-y-5 rounded-xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
        <input type="hidden" name="action" value="${empty importRequest ? 'create' : 'update'}"><c:if test="${not empty importRequest}"><input type="hidden" name="requestId" value="${importRequest.requestId}"></c:if>
        <label class="block max-w-2xl text-sm font-semibold">Nhà cung cấp<select name="supplierId" required class="mt-1.5 w-full rounded-lg border border-slate-300 px-3 py-2.5"><option value="">-- Chọn nhà cung cấp --</option><c:forEach var="supplier" items="${suppliers}"><option value="${supplier.supplierId}" ${not empty importRequest and supplier.supplierId == request.supplierId ? 'selected' : ''}><c:out value="${supplier.supplierName}"/></option></c:forEach></select></label>
        <div><div class="mb-3 flex flex-wrap items-center justify-between gap-2"><div><h2 class="font-semibold">Danh sách sản phẩm</h2><p class="text-xs text-slate-500">Giá mua được lưu riêng trên từng dòng đơn.</p></div><button type="button" onclick="addLine()" class="rounded-lg border border-emerald-200 px-3 py-2 text-sm font-semibold text-emerald-700">+ Thêm dòng</button></div>
            <div class="hidden gap-2 px-1 pb-2 text-xs font-semibold uppercase text-slate-400 md:grid md:grid-cols-[1fr_150px_220px_42px]"><span>Sản phẩm</span><span>Số lượng</span><span>Đơn giá mua (₫)</span><span></span></div>
            <div id="purchase-lines" class="space-y-2"><c:if test="${not empty importRequest}"><c:forEach var="item" items="${importRequest.items}"><div class="purchase-line grid gap-2 rounded-lg border border-slate-100 p-2 md:grid-cols-[1fr_150px_220px_42px]"><select name="productIds" required class="min-w-0 rounded-lg border border-slate-300 px-3 py-2"><c:forEach var="product" items="${products}"><option value="${product.productId}" ${product.productId == item.productId ? 'selected' : ''}><c:out value="${product.productCode}"/> — <c:out value="${product.productName}"/></option></c:forEach></select><input name="quantities" type="number" min="1" max="2147483647" required value="${item.quantity}" class="rounded-lg border border-slate-300 px-3 py-2" aria-label="Số lượng"><input name="unitPrices" type="number" min="0.01" max="9999999999999999.99" step="0.01" required value="${item.unitPrice}" class="rounded-lg border border-slate-300 px-3 py-2" aria-label="Đơn giá mua"><button type="button" onclick="removeLine(this)" class="rounded-lg border border-rose-200 text-rose-600" aria-label="Xóa dòng"><i class="fa-solid fa-trash"></i></button></div></c:forEach></c:if></div>
        </div>
        <div class="flex flex-wrap gap-2"><button class="rounded-lg bg-emerald-600 px-5 py-2.5 text-sm font-semibold text-white">${empty importRequest ? 'Tạo đơn Pending' : 'Lưu thay đổi'}</button><a href="${pageContext.request.contextPath}/app/purchasing/requests" class="rounded-lg border border-slate-300 px-5 py-2.5 text-sm font-semibold">Hủy</a></div>
    </form></c:otherwise></c:choose>
</section></main></div></div>
<template id="line-template"><div class="purchase-line grid gap-2 rounded-lg border border-slate-100 p-2 md:grid-cols-[1fr_150px_220px_42px]"><select name="productIds" required class="min-w-0 rounded-lg border border-slate-300 px-3 py-2"><option value="">-- Chọn sản phẩm --</option><c:forEach var="product" items="${products}"><option value="${product.productId}"><c:out value="${product.productCode}"/> — <c:out value="${product.productName}"/></option></c:forEach></select><input name="quantities" type="number" min="1" max="2147483647" required placeholder="Số lượng" class="rounded-lg border border-slate-300 px-3 py-2" aria-label="Số lượng"><input name="unitPrices" type="number" min="0.01" max="9999999999999999.99" step="0.01" required placeholder="Đơn giá mua" class="rounded-lg border border-slate-300 px-3 py-2" aria-label="Đơn giá mua"><button type="button" onclick="removeLine(this)" class="rounded-lg border border-rose-200 text-rose-600" aria-label="Xóa dòng"><i class="fa-solid fa-trash"></i></button></div></template>
<script>function addLine(){document.getElementById('purchase-lines').appendChild(document.getElementById('line-template').content.cloneNode(true));}function removeLine(button){button.closest('.purchase-line').remove();}if(document.getElementById('purchase-lines').children.length===0)addLine();</script>
</body></html>
