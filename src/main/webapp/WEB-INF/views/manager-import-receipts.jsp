<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" language="java" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Duyệt phiếu nhập kho | LIMS Manager</title><script src="https://cdn.tailwindcss.com"></script></head><body class="bg-slate-50 text-slate-800"><c:set var="activeManagerMenu" value="receipts"/><%@ include file="manager-shell.jspf" %><main class="mx-auto max-w-7xl space-y-6 px-4 py-6 sm:px-6 sm:py-8"><div class="flex flex-wrap items-end justify-between gap-3"><div><h1 class="text-2xl font-bold">Duyệt phiếu nhập kho</h1><p class="mt-1 text-sm text-slate-500">Đối chiếu chữ ký bàn giao, serial, model và vị trí kho. Chỉ phê duyệt mới ghi tăng tồn kho.</p></div><form method="get" action="${pageContext.request.contextPath}/app/manager/import-receipts"><select name="status" onchange="this.form.submit()" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm"><c:forEach var="state" items="${receiptStatuses}"><option value="${state}" ${statusFilter == state ? 'selected' : ''}>${state == 'ALL' ? 'Tất cả phiếu' : state}</option></c:forEach></select></form></div><c:if test="${not empty notice}"><div class="rounded-lg border border-emerald-200 bg-emerald-50 p-3 text-sm text-emerald-800"><c:out value="${notice}"/></div></c:if><c:if test="${not empty error}"><div class="rounded-lg border border-rose-200 bg-rose-50 p-3 text-sm text-rose-700"><c:out value="${error}"/></div></c:if>
<c:forEach var="receipt" items="${receipts}"><article class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm"><div class="flex flex-wrap items-start justify-between gap-3 border-b border-slate-100 p-4 sm:p-5"><div><div class="flex flex-wrap items-center gap-2"><h2 class="text-lg font-bold">Phiếu nhập #${receipt.receiptId}</h2><span class="rounded-full px-2.5 py-1 text-xs font-semibold ${receipt.status == 'PENDING_MANAGER' ? 'bg-amber-100 text-amber-800' : receipt.status == 'COMPLETED' ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800'}">${receipt.status == 'PENDING_MANAGER' ? 'Chờ duyệt' : receipt.status == 'COMPLETED' ? 'Đã duyệt' : 'Từ chối'}</span><c:if test="${receipt.paperSigned}"><span class="rounded-full bg-blue-50 px-2.5 py-1 text-xs font-semibold text-blue-700">Đã xác nhận giấy có chữ ký</span></c:if></div><p class="mt-1 text-sm text-slate-600">PO #${receipt.requestId} · Bàn giao #${receipt.handoverId} · <c:out value="${receipt.supplierName}"/></p><p class="mt-1 text-xs text-slate-500">Nhân viên kho: <c:out value="${receipt.warehouseStaffName}"/> · <fmt:formatDate value="${receipt.receiptDate}" pattern="dd/MM/yyyy HH:mm"/> · ${receipt.items.size()} máy</p></div></div>
<div class="overflow-x-auto px-4 py-3 sm:px-5"><table class="min-w-full text-left text-sm"><thead class="text-xs uppercase text-slate-500"><tr><th class="py-2 pr-4">Model / mã</th><th class="py-2 pr-4">Serial Number</th><th class="py-2 pr-4">Vị trí</th><th class="py-2 pr-4">Tình trạng</th></tr></thead><tbody class="divide-y divide-slate-100"><c:forEach var="item" items="${receipt.items}"><tr><td class="py-2 pr-4"><c:out value="${item.productName}"/><div class="text-xs text-slate-500"><c:out value="${item.productCode}"/></div></td><td class="py-2 pr-4 font-mono"><c:out value="${item.serialNumber}"/></td><td class="py-2 pr-4"><c:out value="${item.location}"/></td><td class="py-2 pr-4">${item.condition == 'BRAND_NEW' ? 'Mới, nguyên vẹn' : item.condition == 'SCRATCHED' ? 'Trầy xước' : 'Hư hỏng'}</td></tr></c:forEach></tbody></table></div>
<c:if test="${receipt.status == 'PENDING_MANAGER'}"><div class="flex flex-wrap items-start gap-3 border-t border-slate-100 bg-slate-50/70 p-4 sm:px-5"><form method="post" action="${pageContext.request.contextPath}/app/manager/import-receipts"><input type="hidden" name="receiptId" value="${receipt.receiptId}"><input type="hidden" name="decision" value="APPROVE"><button class="rounded-lg bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white"><i class="fa-solid fa-check mr-2"></i>Duyệt và cập nhật kho</button></form><form method="post" action="${pageContext.request.contextPath}/app/manager/import-receipts" class="flex min-w-[280px] flex-1 gap-2"><input type="hidden" name="receiptId" value="${receipt.receiptId}"><input type="hidden" name="decision" value="REJECT"><input name="reason" maxlength="255" required placeholder="Lý do từ chối phiếu nhập" class="min-w-0 flex-1 rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm"><button class="rounded-lg border border-rose-200 bg-white px-4 py-2.5 text-sm font-semibold text-rose-700">Từ chối</button></form></div></c:if><c:if test="${receipt.status == 'REJECTED'}"><div class="border-t border-rose-100 bg-rose-50/50 px-5 py-3 text-sm"><b>Lý do từ chối:</b> <c:out value="${receipt.cancelReason}"/> · Manager: <c:out value="${receipt.managerName}"/></div></c:if><c:if test="${receipt.status == 'COMPLETED'}"><div class="border-t border-emerald-100 bg-emerald-50/50 px-5 py-3 text-sm">Đã duyệt bởi <b><c:out value="${receipt.managerName}"/></b> · <fmt:formatDate value="${receipt.approvedDate}" pattern="dd/MM/yyyy HH:mm"/>. Serial và vị trí đã được ghi vào tồn kho.</div></c:if></article></c:forEach><c:if test="${empty receipts}"><div class="rounded-xl border border-dashed border-slate-300 bg-white px-4 py-14 text-center text-slate-500">Không có phiếu nhập ở trạng thái này.</div></c:if></main></div></div></body></html>
