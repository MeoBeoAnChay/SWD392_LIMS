<%@ page pageEncoding="UTF-8" %>
<div class="min-h-screen bg-slate-50 lg:flex">
    <aside class="hidden w-72 shrink-0 flex-col bg-slate-950 text-slate-200 lg:flex">
        <a href="${pageContext.request.contextPath}/home" class="flex h-20 items-center gap-3 border-b border-white/10 px-6">
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-indigo-500 text-lg text-white shadow-lg shadow-indigo-950/40"><i class="fa-solid fa-laptop"></i></span>
            <span class="text-lg font-bold tracking-wide text-white">LIMS<span class="mt-0.5 block text-xs font-medium tracking-normal text-slate-400">Manager workspace</span></span>
        </a>
        <nav class="flex-1 space-y-2 overflow-y-auto px-4 py-6">
            <p class="px-3 pb-2 text-[10px] font-bold uppercase tracking-[0.18em] text-slate-500">Tổng quan</p>
            <a href="${pageContext.request.contextPath}/home" class="flex items-center gap-3 rounded-xl px-3 py-3 text-sm text-slate-300 transition hover:bg-white/5 hover:text-white"><i class="fa-solid fa-house w-5 text-center text-slate-400"></i> Trang chủ</a>
            <p class="px-3 pb-2 pt-6 text-[10px] font-bold uppercase tracking-[0.18em] text-slate-500">NGHIỆP VỤ</p>
            <details class="group" ${activeManagerMenu == 'requests' or activeManagerMenu == 'receipts' ? 'open' : ''}>
                <summary class="flex cursor-pointer list-none items-center gap-3 rounded-xl px-3 py-2.5 text-sm transition ${activeManagerMenu == 'requests' or activeManagerMenu == 'receipts' ? 'bg-indigo-500 font-semibold text-white' : 'text-slate-300 hover:bg-white/5 hover:text-white'}"><i class="fa-solid fa-boxes-stacked w-5 text-center"></i><span class="flex-1">Quản lý nhập</span><i class="fa-solid fa-chevron-down text-[10px] transition group-open:rotate-180"></i></summary>
                <div class="ml-5 mt-1 space-y-1 border-l border-white/10 pl-3">
                    <a href="${pageContext.request.contextPath}/app/manager/import-requests" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm ${activeManagerMenu == 'requests' ? 'bg-white/10 font-semibold text-white' : 'text-slate-400 hover:bg-white/5 hover:text-white'}">Đơn mua hàng</a>
                    <a href="${pageContext.request.contextPath}/app/manager/import-receipts" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm ${activeManagerMenu == 'receipts' ? 'bg-white/10 font-semibold text-white' : 'text-slate-400 hover:bg-white/5 hover:text-white'}">Phiếu nhập kho</a>
                </div>
            </details>
            <details class="group" ${activeManagerMenu == 'exports' or activeManagerMenu == 'export-receipts' ? 'open' : ''}>
                <summary class="flex cursor-pointer list-none items-center gap-3 rounded-xl px-3 py-2.5 text-sm transition ${activeManagerMenu == 'exports' or activeManagerMenu == 'export-receipts' ? 'bg-indigo-500 font-semibold text-white' : 'text-slate-300 hover:bg-white/5 hover:text-white'}"><i class="fa-solid fa-truck-ramp-box w-5 text-center"></i><span class="flex-1">Quản lý xuất</span><i class="fa-solid fa-chevron-down text-[10px] transition group-open:rotate-180"></i></summary>
                <div class="ml-5 mt-1 space-y-1 border-l border-white/10 pl-3">
                    <a href="${pageContext.request.contextPath}/app/manager/export-requests" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm ${activeManagerMenu == 'exports' ? 'bg-white/10 font-semibold text-white' : 'text-slate-400 hover:bg-white/5 hover:text-white'}">Yêu cầu xuất kho</a>
                    <a href="${pageContext.request.contextPath}/app/manager/export-receipts" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm ${activeManagerMenu == 'export-receipts' ? 'bg-white/10 font-semibold text-white' : 'text-slate-400 hover:bg-white/5 hover:text-white'}">Phiếu xuất kho</a>
                </div>
            </details>
            <details class="group" ${activeManagerMenu == 'stocktakes' ? 'open' : ''}>
                <summary class="flex cursor-pointer list-none items-center gap-3 rounded-xl px-3 py-2.5 text-sm transition ${activeManagerMenu == 'stocktakes' ? 'bg-indigo-500 font-semibold text-white' : 'text-slate-300 hover:bg-white/5 hover:text-white'}"><i class="fa-solid fa-clipboard-list w-5 text-center"></i><span class="flex-1">Kiểm kê kho</span><i class="fa-solid fa-chevron-down text-[10px] transition group-open:rotate-180"></i></summary>
                <div class="ml-5 mt-1 space-y-1 border-l border-white/10 pl-3">
                    <a href="${pageContext.request.contextPath}/app/manager/stocktakes" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm text-slate-400 hover:bg-white/5 hover:text-white">Tạo & phân công kiểm kê</a>
                    <a href="${pageContext.request.contextPath}/app/manager/stocktakes?status=PENDING_MANAGER" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm text-slate-400 hover:bg-white/5 hover:text-white">Duyệt kết quả kiểm kê</a>
                </div>
            </details>            <p class="px-3 pb-1 pt-5 text-[10px] font-bold uppercase tracking-[0.18em] text-slate-500">MASTER DATA</p>
            <details class="group" ${activeManagerMenu == 'catalog' ? 'open' : ''}>
                <summary class="flex cursor-pointer list-none items-center gap-3 rounded-xl px-3 py-2.5 text-sm transition ${activeManagerMenu == 'catalog' ? 'bg-indigo-500 font-semibold text-white' : 'text-slate-300 hover:bg-white/5 hover:text-white'}"><i class="fa-solid fa-cubes-stacked w-5 text-center"></i><span class="flex-1">Quản lý sản phẩm</span><i class="fa-solid fa-chevron-down text-[10px] transition group-open:rotate-180"></i></summary>
                <div class="ml-5 mt-1 space-y-1 border-l border-white/10 pl-3">
                    <a href="${pageContext.request.contextPath}/app/manager/catalog?tab=products" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm ${catalogTab == 'products' ? 'bg-white/10 font-semibold text-white' : 'text-slate-400 hover:bg-white/5 hover:text-white'}"><i class="fa-solid fa-laptop w-4"></i> Model & cấu hình</a>
                    <a href="${pageContext.request.contextPath}/app/manager/catalog?tab=brands" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm ${catalogTab == 'brands' ? 'bg-white/10 font-semibold text-white' : 'text-slate-400 hover:bg-white/5 hover:text-white'}"><i class="fa-solid fa-tags w-4"></i> Thương hiệu</a>
                    <a href="${pageContext.request.contextPath}/app/manager/catalog?tab=lines" class="flex items-center gap-3 rounded-lg px-3 py-2.5 text-sm ${catalogTab == 'lines' ? 'bg-white/10 font-semibold text-white' : 'text-slate-400 hover:bg-white/5 hover:text-white'}"><i class="fa-solid fa-layer-group w-4"></i> Dòng máy</a>
                </div>
            </details>
            <a href="${pageContext.request.contextPath}/app/manager/catalog?tab=suppliers" class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm ${activeManagerMenu == 'catalog' and catalogTab == 'suppliers' ? 'bg-indigo-500 font-semibold text-white' : 'text-slate-300 hover:bg-white/5 hover:text-white'}"><i class="fa-solid fa-truck-field w-5 text-center"></i> Nhà cung cấp</a>
            <a href="${pageContext.request.contextPath}/app/manager/catalog?tab=customers" class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm ${activeManagerMenu == 'catalog' and catalogTab == 'customers' ? 'bg-indigo-500 font-semibold text-white' : 'text-slate-300 hover:bg-white/5 hover:text-white'}"><i class="fa-solid fa-users w-5 text-center"></i> Khách hàng</a>        </nav>
        <div class="border-t border-white/10 p-4">
            <div class="flex items-center gap-3 rounded-xl bg-white/5 p-3">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-indigo-400/20 text-indigo-200"><i class="fa-solid fa-user-tie"></i></span>
                <div class="min-w-0"><p class="truncate text-sm font-semibold text-white"><c:out value="${user.fullName}"/></p><p class="mt-0.5 text-xs text-slate-400">Manager</p></div>
                <a href="${pageContext.request.contextPath}/logout" title="Đăng xuất" class="ml-auto rounded-lg p-2 text-slate-400 transition hover:bg-rose-500/10 hover:text-rose-300"><i class="fa-solid fa-arrow-right-from-bracket"></i></a>
            </div>
        </div>
    </aside>
    <div class="flex min-w-0 flex-1 flex-col">
        <header class="sticky top-0 z-20 flex h-16 items-center justify-between border-b border-slate-200 bg-white/95 px-4 shadow-sm backdrop-blur sm:px-6 lg:px-8">
            <div class="flex items-center gap-3"><span class="flex h-9 w-9 items-center justify-center rounded-lg bg-indigo-50 text-indigo-600 lg:hidden"><i class="fa-solid fa-laptop"></i></span><div><p class="text-[10px] font-bold uppercase tracking-[0.16em] text-slate-400">LIMS / Manager</p><p class="text-sm font-semibold text-slate-800"><c:out value="${activeManagerMenu == 'receipts' ? 'Phê duyệt phiếu nhập kho' : 'Phê duyệt đơn mua hàng'}"/></p></div></div>
            <div class="flex items-center gap-3"><span class="hidden text-sm font-medium text-slate-600 sm:inline"><c:out value="${user.fullName}"/></span><a href="${pageContext.request.contextPath}/logout" class="inline-flex items-center gap-2 rounded-lg border border-slate-200 px-3 py-2 text-xs font-semibold text-slate-600 transition hover:border-rose-200 hover:bg-rose-50 hover:text-rose-700"><i class="fa-solid fa-arrow-right-from-bracket"></i><span class="hidden sm:inline">Đăng xuất</span></a></div>
        </header>
        <details class="border-b border-slate-200 bg-white px-4 py-2 lg:hidden"><summary class="flex cursor-pointer list-none items-center justify-between rounded-lg px-3 py-2 text-sm font-semibold text-slate-700"><span><i class="fa-solid fa-bars mr-2 text-indigo-600"></i>Điều hướng Manager</span><i class="fa-solid fa-chevron-down text-xs"></i></summary><div class="flex flex-col gap-1 pb-2 pt-2">
            <a class="rounded-lg px-3 py-2 text-sm hover:bg-slate-50" href="${pageContext.request.contextPath}/home">Trang chủ</a>
            <details class="rounded-lg bg-slate-50"><summary class="cursor-pointer list-none rounded-lg px-3 py-2 text-sm font-semibold text-indigo-700">Quản lý nhập</summary><div class="ml-3 space-y-1 border-l border-slate-200 py-1 pl-2"><a class="block rounded-lg px-3 py-2 text-sm hover:bg-white" href="${pageContext.request.contextPath}/app/manager/import-requests">Đơn mua hàng</a><a class="block rounded-lg px-3 py-2 text-sm hover:bg-white" href="${pageContext.request.contextPath}/app/manager/import-receipts">Phiếu nhập kho</a></div></details>
            <details class="rounded-lg bg-slate-50"><summary class="cursor-pointer list-none rounded-lg px-3 py-2 text-sm font-semibold text-indigo-700">Quản lý xuất</summary><div class="ml-3 space-y-1 border-l border-slate-200 py-1 pl-2"><a class="block rounded-lg px-3 py-2 text-sm hover:bg-white" href="${pageContext.request.contextPath}/app/manager/export-requests">Yêu cầu xuất kho</a><a class="block rounded-lg px-3 py-2 text-sm hover:bg-white" href="${pageContext.request.contextPath}/app/manager/export-receipts">Phiếu xuất kho</a></div></details>
            <details class="rounded-lg bg-slate-50"><summary class="cursor-pointer list-none rounded-lg px-3 py-2 text-sm font-semibold text-indigo-700">Kiểm kê kho</summary><div class="ml-3 space-y-1 border-l border-slate-200 py-1 pl-2"><a class="block rounded-lg px-3 py-2 text-sm hover:bg-white" href="${pageContext.request.contextPath}/app/manager/stocktakes">Tạo & phân công kiểm kê</a><a class="block rounded-lg px-3 py-2 text-sm hover:bg-white" href="${pageContext.request.contextPath}/app/manager/stocktakes?status=PENDING_MANAGER">Duyệt kết quả kiểm kê</a></div></details>
            <details class="rounded-lg bg-slate-50"><summary class="cursor-pointer list-none rounded-lg px-3 py-2 text-sm font-semibold text-indigo-700">Quản lý sản phẩm</summary><div class="ml-3 space-y-1 border-l border-slate-200 py-1 pl-2"><a class="block rounded-lg px-3 py-2 text-sm hover:bg-white" href="${pageContext.request.contextPath}/app/manager/catalog?tab=products">Model & cấu hình</a><a class="block rounded-lg px-3 py-2 text-sm hover:bg-white" href="${pageContext.request.contextPath}/app/manager/catalog?tab=brands">Thương hiệu</a><a class="block rounded-lg px-3 py-2 text-sm hover:bg-white" href="${pageContext.request.contextPath}/app/manager/catalog?tab=lines">Dòng máy</a></div></details>
            <a class="rounded-lg px-3 py-2 text-sm hover:bg-slate-50" href="${pageContext.request.contextPath}/app/manager/catalog?tab=suppliers">Nhà cung cấp</a><a class="rounded-lg px-3 py-2 text-sm hover:bg-slate-50" href="${pageContext.request.contextPath}/app/manager/catalog?tab=customers">Khách hàng</a>
        </div></details><a class="rounded-lg px-3 py-2 text-sm hover:bg-slate-50" href="${pageContext.request.contextPath}/app/manager/catalog?tab=suppliers">Nhà cung cấp</a><a class="rounded-lg px-3 py-2 text-sm hover:bg-slate-50" href="${pageContext.request.contextPath}/app/manager/catalog?tab=customers">Khách hàng</a></div></details>
