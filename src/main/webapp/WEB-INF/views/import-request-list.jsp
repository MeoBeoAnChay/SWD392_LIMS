<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" language="java" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %><%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>${statusFilter == 'COMPLETED' ? 'Lịch sử mua hàng' : 'Danh sách đơn mua'} | LIMS</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"></head><body class="bg-slate-50 text-slate-800"><%@ include file="purchasing-shell.jspf" %>
<section><div class="flex flex-wrap items-end justify-between gap-3"><div><h1 class="text-2xl font-bold">${statusFilter == 'COMPLETED' ? 'Lịch sử mua hàng' : 'Danh sách đơn mua'}</h1><p class="mt-1 text-sm text-slate-500">Tra cứu và theo dõi trạng thái các yêu cầu do bạn tạo.</p></div><a href="${pageContext.request.contextPath}/app/purchasing/request-form" class="rounded-lg bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white"><i class="fa-solid fa-plus mr-2"></i>Tạo đơn</a></div>
    <form method="get" action="${pageContext.request.contextPath}/app/purchasing/requests" class="grid gap-3 rounded-xl border border-slate-200 bg-white p-4 shadow-sm sm:grid-cols-2 lg:grid-cols-5"><label class="text-xs font-semibold text-slate-500">Trạng thái<select name="status" class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"><option value="">Tất cả trạng thái</option><c:forEach var="state" items="${requestStatuses}"><option value="${state}" ${statusFilter == state ? 'selected' : ''}>${state}</option></c:forEach></select></label><label class="text-xs font-semibold text-slate-500">Mã đơn / nhà cung cấp<input name="search" value="${fn:escapeXml(searchFilter)}" class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm" placeholder="Ví dụ: 12 hoặc Synnex"></label><label class="text-xs font-semibold text-slate-500">Từ ngày<input type="date" name="from" value="${fromFilter}" class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"></label><label class="text-xs font-semibold text-slate-500">Đến ngày<input type="date" name="to" value="${toFilter}" class="mt-1 block w-full rounded-lg border border-slate-300 px-3 py-2 text-sm"></label><div class="flex items-end gap-2"><button class="rounded-lg bg-slate-800 px-4 py-2 text-sm font-semibold text-white">Lọc</button><a href="${pageContext.request.contextPath}/app/purchasing/requests" class="rounded-lg border border-slate-300 px-4 py-2 text-sm">Xóa lọc</a></div></form>
    <div class="space-y-4"><c:forEach var="order" items="${requests}"><article class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm"><div class="flex flex-wrap items-start justify-between gap-3 border-b border-slate-100 p-4 sm:p-5"><div><div class="flex flex-wrap items-center gap-2"><h2 class="font-bold">Đơn #${order.requestId}</h2><span class="rounded-full px-2.5 py-1 text-xs font-semibold ${order.status == 'PENDING' ? 'bg-amber-100 text-amber-800' : order.status == 'APPROVED' ? 'bg-emerald-100 text-emerald-800' : order.status == 'REJECTED' ? 'bg-rose-100 text-rose-800' : order.status == 'COMPLETED' ? 'bg-blue-100 text-blue-800' : 'bg-slate-100 text-slate-700'}"><c:out value="${order.status}"/></span></div><p class="mt-1 text-sm text-slate-600"><b>Nhà cung cấp:</b> <c:out value="${order.supplierName}"/> · <fmt:formatDate value="${order.requestDate}" pattern="dd/MM/yyyy HH:mm"/></p></div><div class="text-sm text-slate-600">Đặt <b>${order.orderedQuantity}</b> máy · Bàn giao <b>${order.handedOverQuantity}</b> · Còn <b>${order.remainingQuantity}</b></div></div>
            <div class="overflow-x-auto px-4 py-2 sm:px-5"><table class="min-w-full text-left text-sm"><thead class="text-xs uppercase text-slate-400"><tr><th class="py-2 pr-4">Mã SP</th><th class="py-2 pr-4">Sản phẩm</th><th class="py-2 pr-4">SL</th><th class="py-2 pr-4">Đơn giá mua</th><th class="py-2">Tạm tính</th></tr></thead><tbody class="divide-y divide-slate-100"><c:forEach var="item" items="${order.items}"><tr><td class="py-2 pr-4"><c:out value="${item.productCode}"/></td><td class="py-2 pr-4"><c:out value="${item.productName}"/></td><td class="py-2 pr-4">${item.quantity}</td><td class="py-2 pr-4"><fmt:formatNumber value="${item.unitPrice}" pattern="#,##0.00"/> ₫</td><td class="py-2"><fmt:formatNumber value="${item.unitPrice * item.quantity}" pattern="#,##0.00"/> ₫</td></tr></c:forEach></tbody></table></div>
            <c:if test="${not empty order.cancelReason}"><div class="mx-4 mb-3 rounded-lg ${order.status == 'REJECTED' ? 'bg-rose-50 text-rose-800' : 'bg-slate-50 text-slate-700'} p-3 text-sm sm:mx-5"><b>${order.status == 'REJECTED' ? 'Lý do từ chối:' : 'Lý do hủy:'}</b> <c:out value="${order.cancelReason}"/></div></c:if>
            <div class="flex flex-wrap gap-2 border-t border-slate-100 bg-slate-50/60 p-4 sm:px-5"><c:if test="${order.status == 'PENDING'}"><a href="${pageContext.request.contextPath}/app/purchasing/request-form?requestId=${order.requestId}" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-semibold">Sửa đơn</a><details><summary class="cursor-pointer rounded-lg border border-rose-200 bg-white px-3 py-2 text-xs font-semibold text-rose-700">Hủy đơn</summary><form method="post" action="${pageContext.request.contextPath}/app/purchasing/requests" class="absolute z-10 mt-1 w-72 rounded-lg border border-slate-200 bg-white p-3 shadow-lg"><input type="hidden" name="action" value="cancel"><input type="hidden" name="requestId" value="${order.requestId}"><label class="text-xs font-semibold">Lý do hủy<textarea name="reason" maxlength="255" required class="mt-1 w-full rounded border border-slate-300 p-2"></textarea></label><button class="mt-2 rounded bg-rose-600 px-3 py-2 text-xs font-semibold text-white">Xác nhận hủy</button></form></details></c:if><c:if test="${order.status == 'APPROVED' and order.remainingQuantity > 0}"><a href="${pageContext.request.contextPath}/app/purchasing/handover-form?requestId=${order.requestId}" class="rounded-lg bg-emerald-600 px-3 py-2 text-xs font-semibold text-white">Tạo phiếu bàn giao</a></c:if><c:if test="${not empty order.handovers}"><a href="${pageContext.request.contextPath}/app/purchasing/handovers" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-semibold">Xem bàn giao</a></c:if></div>
        </article></c:forEach><c:if test="${empty requests}"><div class="rounded-xl border border-dashed border-slate-300 bg-white p-10 text-center text-sm text-slate-500">Không tìm thấy đơn mua hàng phù hợp.</div></c:if></div>
</section></main></div></div></body></html>
