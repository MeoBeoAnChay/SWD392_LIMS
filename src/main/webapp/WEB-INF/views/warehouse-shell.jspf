<%@ page pageEncoding="UTF-8" %>
<div class="min-h-screen bg-slate-50 lg:flex">
    <aside class="hidden w-72 shrink-0 flex-col bg-slate-950 text-slate-200 lg:flex">
        <a href="${pageContext.request.contextPath}/app/warehouse/dashboard" class="flex h-20 items-center gap-3 border-b border-white/10 px-6"><span class="flex h-11 w-11 items-center justify-center rounded-xl bg-amber-500 text-lg text-white"><i class="fa-solid fa-warehouse"></i></span><span class="text-lg font-bold text-white">LIMS<span class="mt-0.5 block text-xs font-medium text-slate-400">Warehouse workspace</span></span></a>
        <nav class="flex-1 space-y-2 overflow-y-auto px-4 py-6">
            <a href="${pageContext.request.contextPath}/app/warehouse/dashboard" class="flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm ${activeWarehouseMenu == 'dashboard' ? 'bg-amber-500 font-semibold text-white' : 'text-slate-300 hover:bg-white/5 hover:text-white'}"><i class="fa-solid fa-chart-pie w-5 text-center"></i> Dashboard & công việc</a>
            <p class="px-3 pb-1 pt-5 text-[10px] font-bold uppercase tracking-[0.18em] text-slate-500">NGHIỆP VỤ KHO</p>
            <details class="group" ${activeWarehouseMenu == 'handovers' or activeWarehouseMenu == 'import-history' ? 'open' : ''}><summary class="flex cursor-pointer list-none items-center gap-3 rounded-xl px-3 py-2.5 text-sm ${activeWarehouseMenu == 'handovers' or activeWarehouseMenu == 'import-history' ? 'bg-amber-500 font-semibold text-white' : 'text-slate-300 hover:bg-white/5 hover:text-white'}"><i class="fa-solid fa-boxes-stacked w-5 text-center"></i><span class="flex-1">Nhập kho</span><i class="fa-solid fa-chevron-down text-[10px] transition group-open:rotate-180"></i></summary><div class="ml-5 mt-1 space-y-1 border-l border-white/10 pl-3"><a href="${pageContext.request.contextPath}/app/warehouse/handovers" class="block rounded-lg px-3 py-2.5 text-sm ${activeWarehouseMenu == 'handovers' ? 'bg-white/10 text-white' : 'text-slate-400 hover:bg-white/5 hover:text-white'}">Danh sách phiếu nhập</a><a href="${pageContext.request.contextPath}/app/warehouse/import-history" class="block rounded-lg px-3 py-2.5 text-sm ${activeWarehouseMenu == 'import-history' ? 'bg-white/10 text-white' : 'text-slate-400 hover:bg-white/5 hover:text-white'}">Lịch sử nhập kho</a></div></details>
            <details class="group" ${activeWarehouseMenu == 'exports' or activeWarehouseMenu == 'export-history' ? 'open' : ''}><summary class="flex cursor-pointer list-none items-center gap-3 rounded-xl px-3 py-2.5 text-sm ${activeWarehouseMenu == 'exports' or activeWarehouseMenu == 'export-history' ? 'bg-amber-500 font-semibold text-white' : 'text-slate-300 hover:bg-white/5 hover:text-white'}"><i class="fa-solid fa-truck-ramp-box w-5 text-center"></i><span class="flex-1">Xuất kho</span><i class="fa-solid fa-chevron-down text-[10px] transition group-open:rotate-180"></i></summary><div class="ml-5 mt-1 space-y-1 border-l border-white/10 pl-3"><a href="${pageContext.request.contextPath}/app/warehouse/export-requests" class="block rounded-lg px-3 py-2.5 text-sm ${activeWarehouseMenu == 'exports' ? 'bg-white/10 text-white' : 'text-slate-400 hover:bg-white/5 hover:text-white'}">Danh sách đơn xuất</a><a href="${pageContext.request.contextPath}/app/warehouse/export-history" class="block rounded-lg px-3 py-2.5 text-sm ${activeWarehouseMenu == 'export-history' ? 'bg-white/10 text-white' : 'text-slate-400 hover:bg-white/5 hover:text-white'}">Lịch sử xuất kho</a></div></details>
            <details class="group" ${activeWarehouseMenu == 'stocktakes' ? 'open' : ''}><summary class="flex cursor-pointer list-none items-center gap-3 rounded-xl px-3 py-2.5 text-sm ${activeWarehouseMenu == 'stocktakes' ? 'bg-amber-500 font-semibold text-white' : 'text-slate-300 hover:bg-white/5 hover:text-white'}"><i class="fa-solid fa-clipboard-list w-5 text-center"></i><span class="flex-1">Kiểm kê kho</span><i class="fa-solid fa-chevron-down text-[10px] transition group-open:rotate-180"></i></summary><div class="ml-5 mt-1 space-y-1 border-l border-white/10 pl-3"><a href="${pageContext.request.contextPath}/app/warehouse/stocktakes" class="block rounded-lg px-3 py-2.5 text-sm ${activeWarehouseMenu == 'stocktakes' ? 'bg-white/10 text-white' : 'text-slate-400 hover:bg-white/5 hover:text-white'}">Danh sách kiểm kho</a></div></details>
        </nav>
        <div class="border-t border-white/10 p-4"><div class="flex items-center gap-3 rounded-xl bg-white/5 p-3"><span class="flex h-10 w-10 items-center justify-center rounded-full bg-amber-400/20 text-amber-200"><i class="fa-solid fa-user-gear"></i></span><div class="min-w-0"><p class="truncate text-sm font-semibold text-white"><c:out value="${user.fullName}"/></p><p class="text-xs text-slate-400">Warehouse Staff</p></div><a href="${pageContext.request.contextPath}/logout" title="Đăng xuất" class="ml-auto rounded-lg p-2 text-slate-400 hover:bg-rose-500/10 hover:text-rose-300"><i class="fa-solid fa-arrow-right-from-bracket"></i></a></div></div>
    </aside>
    <div class="flex min-w-0 flex-1 flex-col">
        <header class="sticky top-0 z-20 flex h-16 items-center justify-between border-b border-slate-200 bg-white/95 px-4 shadow-sm backdrop-blur sm:px-6 lg:px-8"><div class="flex items-center gap-3"><span class="flex h-9 w-9 items-center justify-center rounded-lg bg-amber-50 text-amber-700 lg:hidden"><i class="fa-solid fa-warehouse"></i></span><div><p class="text-[10px] font-bold uppercase tracking-[0.16em] text-slate-400">LIMS / Warehouse</p><p class="text-sm font-semibold text-slate-800"><c:out value="${activeWarehouseMenu == 'dashboard' ? 'Dashboard & công việc' : activeWarehouseMenu == 'exports' ? 'Xuất kho' : activeWarehouseMenu == 'stocktakes' ? 'Kiểm kê kho' : 'Nhập kho'}"/></p></div></div><div class="flex items-center gap-3"><span class="hidden text-sm font-medium text-slate-600 sm:inline"><c:out value="${user.fullName}"/></span><a href="${pageContext.request.contextPath}/logout" class="inline-flex items-center gap-2 rounded-lg border border-slate-200 px-3 py-2 text-xs font-semibold text-slate-600 hover:border-rose-200 hover:bg-rose-50 hover:text-rose-700"><i class="fa-solid fa-arrow-right-from-bracket"></i><span class="hidden sm:inline">Đăng xuất</span></a></div></header>
        <details class="border-b border-slate-200 bg-white px-4 py-2 lg:hidden"><summary class="flex cursor-pointer list-none items-center justify-between rounded-lg px-3 py-2 text-sm font-semibold text-slate-700"><span><i class="fa-solid fa-bars mr-2 text-amber-600"></i>Điều hướng kho</span><i class="fa-solid fa-chevron-down text-xs"></i></summary><div class="flex flex-col gap-1 pb-2 pt-2"><a class="rounded-lg px-3 py-2 text-sm hover:bg-slate-50" href="${pageContext.request.contextPath}/app/warehouse/dashboard">Dashboard & công việc</a><details class="rounded-lg bg-slate-50"><summary class="cursor-pointer list-none rounded-lg px-3 py-2 text-sm font-semibold text-amber-800">Nhập kho</summary><a class="ml-3 block border-l border-slate-200 px-4 py-2 text-sm hover:bg-white" href="${pageContext.request.contextPath}/app/warehouse/handovers">Danh sách phiếu nhập</a><a class="ml-3 block border-l border-slate-200 px-4 py-2 text-sm hover:bg-white" href="${pageContext.request.contextPath}/app/warehouse/import-history">Lịch sử nhập kho</a></details><details class="rounded-lg bg-slate-50"><summary class="cursor-pointer list-none rounded-lg px-3 py-2 text-sm font-semibold text-amber-800">Xuất kho</summary><a class="ml-3 block border-l border-slate-200 px-4 py-2 text-sm hover:bg-white" href="${pageContext.request.contextPath}/app/warehouse/export-requests">Danh sách đơn xuất</a><a class="ml-3 block border-l border-slate-200 px-4 py-2 text-sm hover:bg-white" href="${pageContext.request.contextPath}/app/warehouse/export-history">Lịch sử xuất kho</a></details><details class="rounded-lg bg-slate-50"><summary class="cursor-pointer list-none rounded-lg px-3 py-2 text-sm font-semibold text-amber-800">Kiểm kê kho</summary><a class="ml-3 block border-l border-slate-200 px-4 py-2 text-sm hover:bg-white" href="${pageContext.request.contextPath}/app/warehouse/stocktakes">Danh sách kiểm kho</a></details></div></details>


